---
import { localeFromPath } from "../lib/i18n";
import { useTranslations } from "../config/i18n";

import { getSiteConfig } from "../config/site";
import DotField from "./DotField.astro";
import Greeting from "./Greeting.astro";
import ScrambleName from "./ScrambleName.astro";
import HeroJourney from "./HeroJourney.astro";
import CvDropdown from "./CvDropdown.astro";

const locale = localeFromPath(Astro.url.pathname);
const t = useTranslations(locale);
const siteConfig = getSiteConfig(locale);
---

<hero-section
  id="top"
  class="hero-root relative flex min-h-[100svh] flex-col items-center justify-center overflow-hidden pt-[var(--nav-h)]"
  data-timezone={siteConfig.timezone}
  style="transform: translateZ(0); display: flex;"
>

  <DotField />
  <HeroJourney />

  <div
    aria-hidden="true"
    class="nav-haze pointer-events-none fixed left-4 top-3 z-50 hidden h-[38px] select-none items-center gap-2 rounded-full border border-[var(--glass-border)] px-3.5 font-mono text-xs text-[var(--ink-dim)] lg:flex"
    style="animation: hero-fade 500ms var(--ease) both;"
  >
    <span class="hero-clock tabular-nums">--:--:--</span>
    <span class="text-[var(--ink-faint)]">
      (gmt{siteConfig.tzOffset} / {siteConfig.tzLabel})
    </span>
  </div>

  <div
    aria-hidden="true"
    class="hero-gated pointer-events-none fixed right-4 top-3 z-50 hidden h-[38px] select-none items-center gap-2.5 rounded-full border border-[var(--glass-border)] bg-[var(--glass-bg)] px-3.5 font-mono text-xs text-[var(--ink-muted)] backdrop-blur-md lg:flex hf-500-200"
    style="box-shadow: var(--glass-inset);"
  >
    <span class="relative flex h-2 w-2">
      <span
        aria-hidden="true"
        class="absolute -inset-1.5 rounded-full"
        style="background: radial-gradient(circle, rgba(255,255,255,0.25) 0%, transparent 70%); animation: status-pulse 2.4s ease-in-out infinite;"
      ></span>
      <span
        class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[var(--ink)] opacity-60"></span>
      <span
        class="relative inline-flex h-2 w-2 rounded-full"
        style="background: var(--ink); box-shadow: 0 0 8px rgba(255,255,255,0.45);"></span>
    </span>
    <span class="text-[var(--ink)]">{siteConfig.status.label}</span>
  </div>

  <div class="relative z-10 grid w-full min-h-[calc(100svh-var(--nav-h))] place-items-center">
    <div class="hero-gated group relative [grid-area:1/1] hf-800-0">

      <div
        aria-hidden="true"
        class="pointer-events-none absolute left-1/2 top-[38%] h-[84%] w-[148%] -translate-x-1/2 -translate-y-1/2"
        style="background: radial-gradient(ellipse 45% 40% at 50% 50%, rgba(255,255,255,0.06) 0%, transparent 65%);"
      >
      </div>

      <img
        src="/portrait-hero.webp"
        width="720"
        height="1469"
        alt="Mohamed Islam Benyahkem"
        loading="eager"
        class="hero-portrait relative block h-[clamp(42rem,104svh,70rem)] w-auto max-w-[94vw] -translate-y-[clamp(0.75rem,3vh,2.5rem)] object-contain bw-img" />
    </div>

    <div class="hero-copy relative isolate z-10 flex [grid-area:1/1] self-end flex-col items-center px-6 pb-[clamp(5.5rem,11vh,8rem)] text-center">

      <div aria-hidden="true" class="hero-copy__wash pointer-events-none absolute -inset-x-12 -bottom-8 -top-20 -z-10"></div>
      <p
        class="hero-gated font-mono text-[clamp(1.6rem,4.4vw,2.4rem)] tracking-[0.16em] text-[var(--ink)] uppercase hf-700-100"
      >
        <Greeting />
      </p>
      <h1
        class="mt-3 flex flex-col items-start font-sans font-semibold leading-[1.0] tracking-[-0.04em] text-[var(--ink)] text-[clamp(1.35rem,5.6vw,1.9rem)] md:text-[clamp(2rem,7vw,4.75rem)]"
      >

        <span
          class="hero-gated font-light hf-200-0"
          style="color: var(--ink-soft); font-size: 0.4em; letter-spacing: 0.06em; margin-bottom: 0.25em;"
        >
          {t("I am")}
        </span>

        <span class="text-[var(--ink)]">
          <ScrambleName /><span class="text-[var(--ink-soft)]">.</span>
        </span>
      </h1>

      <p
        class="hero-gated mt-5 max-w-[42rem] font-mono text-[clamp(0.8rem,1.6vw,0.95rem)] tracking-[0.08em] text-[var(--ink-soft)] hf-800-400"
      >
        {siteConfig.roleKeywords}
      </p>

      <div class="hero-gated mt-8 mb-16 flex flex-wrap items-center justify-center gap-3.5 hf-800-600">
        <CvDropdown locale={locale} />
        <a
          href="#contact"
          class="hero-cta-contact group/ct inline-flex min-h-[44px] items-center gap-2.5 rounded-[var(--radius-sm)] px-6 py-3 font-mono text-sm tracking-[0.06em] transition-all [transition-duration:var(--transition-fast)] hover:-translate-y-0.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--signal)]/60"
          data-sound-hover
          data-sound-click
        >
          <span>{t("contact")}</span>

          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            class="transition-transform [transition-duration:var(--transition-fast)] group-hover/ct:translate-y-0.5"
          >
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <polyline points="19 12 12 19 5 12"></polyline>
          </svg>
        </a>
      </div>
    </div>
  </div>

  <div
    class="hero-gated absolute bottom-10 left-1/2 -translate-x-1/2 font-mono text-xs tracking-[0.32em] text-[var(--ink-dim)] uppercase hf-800-800"
  >
    <span class="inline-flex flex-col items-center gap-2.5">
      <span class="flex items-center gap-2">
        <span aria-hidden="true" class="text-[var(--ink-faint)]">[</span>
        <span>{t("scroll")}</span>
        <span aria-hidden="true" class="text-[var(--ink-faint)]">]</span>
      </span>
      <span class="relative block h-8 w-px overflow-hidden bg-[var(--line)]">
        <span
          class="absolute left-0 top-0 h-3 w-px animate-[scroll-line_1.8s_ease-in-out_infinite] bg-[var(--ink)]"
        ></span>
      </span>
    </span>
  </div>
</hero-section>

<script>
  import { playSound } from "../scripts/sound-init";

  function formatTime(timezone: string): string {
    if (typeof Intl === "undefined") {
      const d = new Date();
      const p = (n: number) => String(n).padStart(2, "0");
      return `${p(d.getHours())}:${p(d.getMinutes())}:${p(d.getSeconds())}`;
    }
    try {
      const parts = new Intl.DateTimeFormat("en-GB", {
        hour: "2-digit",
        minute: "2-digit",
        second: "2-digit",
        hour12: false,
        timeZone: timezone,
      }).formatToParts(new Date());
      const get = (t: string) =>
        parts.find((p) => p.type === t)?.value ?? "00";
      return `${get("hour")}:${get("minute")}:${get("second")}`;
    } catch {
      const d = new Date();
      const p = (n: number) => String(n).padStart(2, "0");
      return `${p(d.getHours())}:${p(d.getMinutes())}:${p(d.getSeconds())}`;
    }
  }

  class HeroSectionEl extends HTMLElement {
    private cleanupFns: (() => void)[] = [];

    connectedCallback() {

      const motion = window.matchMedia("(prefers-reduced-motion: reduce)");
      const reveal = () => {
        this.classList.remove("is-loading");
        this.classList.add("revealed");
      };
      const stage = () => {
        if (motion.matches || document.documentElement.dataset.clientNavigation === "true") {
          this.classList.add("is-client-navigation");
          reveal();
          return;
        }
        this.classList.remove("revealed", "is-client-navigation");
        this.classList.add("is-loading", "is-enhanced");
      };
      const onState = (event: Event) => {
        if ((event as CustomEvent<{ state: string }>).detail.state === "loading") stage();
        else reveal();
      };
      if (document.documentElement.dataset.loaderState === "loading") stage();
      else {
        this.classList.add("is-client-navigation");
        reveal();
      }
      window.addEventListener("loader:statechange", onState);
      window.addEventListener("loader:dismiss", reveal);
      this.cleanupFns.push(() => {
        window.removeEventListener("loader:dismiss", reveal);
        window.removeEventListener("loader:statechange", onState);
      });

      this.querySelectorAll<HTMLElement>("[data-sound-hover]").forEach((el) => {
        const onHover = () => playSound("hover");
        el.addEventListener("mouseenter", onHover);
        this.cleanupFns.push(() => el.removeEventListener("mouseenter", onHover));
      });
      this.querySelectorAll<HTMLElement>("[data-sound-click]").forEach((el) => {
        const onClick = () => playSound("click");
        el.addEventListener("click", onClick);
        this.cleanupFns.push(() => el.removeEventListener("click", onClick));
      });

      const clock = this.querySelector<HTMLElement>(".hero-clock");
      if (clock) {
        const tz = this.dataset.timezone ?? "Africa/Algiers";
        const tick = () => (clock.textContent = formatTime(tz));
        const raf = requestAnimationFrame(tick);
        let id: ReturnType<typeof setInterval> | null = setInterval(tick, 1000);
        const onVis = () => {
          if (document.hidden) {
            if (id) {
              clearInterval(id);
              id = null;
            }
          } else if (!id) {
            tick();
            id = setInterval(tick, 1000);
          }
        };
        document.addEventListener("visibilitychange", onVis);
        this.cleanupFns.push(() => {
          cancelAnimationFrame(raf);
          if (id) clearInterval(id);
          document.removeEventListener("visibilitychange", onVis);
        });
      }
    }

    disconnectedCallback() {
      this.cleanupFns.forEach((fn) => fn());
      this.cleanupFns = [];
    }
  }

  customElements.define("hero-section", HeroSectionEl);
</script>

<style>

  .hero-portrait {
    -webkit-mask-image: linear-gradient(to bottom, #000 42%, #000 50%, transparent 94%);
    mask-image: linear-gradient(to bottom, #000 42%, #000 50%, transparent 94%);
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
  }

  .hero-copy__wash {
    background: linear-gradient(
      to bottom,
      transparent 0%,
      rgba(var(--scrim-color), 0.48) 24%,
      rgba(var(--scrim-color), 0.90) 64%,
      var(--bg) 100%
    );
  }

  .hero-cta-contact {
    background: var(--ink);
    color: var(--bg);
    box-shadow: 0 6px 20px -8px rgba(255, 255, 255, 0.30);
  }
  :global(html.light) .hero-cta-contact {
    box-shadow: 0 6px 20px -8px rgba(0, 0, 0, 0.25);
  }
  .hero-cta-contact:hover {
    box-shadow: 0 8px 24px -6px rgba(255, 255, 255, 0.38);
  }
  :global(html.light) .hero-cta-contact:hover {
    box-shadow: 0 8px 24px -6px rgba(0, 0, 0, 0.35);
  }

  @keyframes hero-fade {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes scroll-line {
    0% {
      transform: translateY(-12px);
      opacity: 0;
    }
    20% {
      opacity: 1;
    }
    80% {
      opacity: 1;
    }
    100% {
      transform: translateY(32px);
      opacity: 0;
    }
  }
  @keyframes status-pulse {
    0%,
    100% {
      opacity: 0.4;
      transform: scale(0.9);
    }
    50% {
      opacity: 1;
      transform: scale(1.15);
    }
  }

  .hero-root.is-loading .hero-gated {
    opacity: 0;
  }
  .hero-root.is-enhanced.revealed .hf-200-0 {
    animation: hero-fade 200ms var(--ease) 0ms both;
  }
  .hero-root.is-enhanced.revealed .hf-500-200 {
    animation: hero-fade 500ms var(--ease) 200ms both;
  }
  .hero-root.is-enhanced.revealed .hf-700-100 {
    animation: hero-fade 700ms var(--ease) 100ms both;
  }
  .hero-root.is-enhanced.revealed .hf-800-0 {
    animation: hero-fade 800ms var(--ease) 0ms both;
  }
  .hero-root.is-enhanced.revealed .hf-800-400 {
    animation: hero-fade 800ms var(--ease) 400ms both;
  }
  .hero-root.is-enhanced.revealed .hf-800-600 {
    animation: hero-fade 800ms var(--ease) 600ms both;
  }
  .hero-root.is-enhanced.revealed .hf-800-800 {
    animation: hero-fade 800ms var(--ease) 800ms both;
  }
  .hero-root.is-client-navigation.revealed .hero-gated {
    opacity: 1;
    transform: none;
    animation: none;
  }
</style>
