---
/**
 * AmbientSignal — a few slow horizontal sine lines drifting across the
 * footer. Reads as "signal on the wire" — calm, atmospheric, never loud.
 *
 * - Canvas 2D, monochrome white, very low opacity
 * - Mouse-reactive: lines bend toward the cursor with a falloff, and a
 *   soft white bloom follows the cursor position
 * - Paused when off-screen (IntersectionObserver)
 * - Static single render on prefers-reduced-motion
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<ambient-signal class={`pointer-events-none absolute inset-0 overflow-hidden block ${className ?? ""}`} aria-hidden="true">
  <canvas class="block h-full w-full"></canvas>
  <!-- fade edges to bg -->
  <div
    class="pointer-events-none absolute inset-0"
    style="background: linear-gradient(to right, var(--bg) 0%, transparent 15%, transparent 85%, var(--bg) 100%);"
  >
  </div>
</ambient-signal>

<script>
  class AmbientSignalEl extends HTMLElement {
    private cleanupFns: (() => void)[] = [];

    connectedCallback() {
      const canvas = this.querySelector<HTMLCanvasElement>("canvas");
      if (!canvas) return;
      const ctx = canvas.getContext("2d");
      if (!ctx) return;

      const reduced = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;
      const finePointer = window.matchMedia("(pointer: fine)").matches;

      // Platform color management (WhatsApp emerald default)
      const parseRgb = (str: string): [number, number, number] => {
        const parts = str.split(",").map((s) => parseFloat(s.trim()));
        if (parts.length === 3 && parts.every((n) => Number.isFinite(n))) {
          return [parts[0], parts[1], parts[2]];
        }
        return [37, 211, 102];
      };

      const getActiveRgb = (): [number, number, number] => {
        const custom = getComputedStyle(this).getPropertyValue("--platform-rgb").trim();
        if (custom) return parseRgb(custom);
        return [37, 211, 102];
      };

      let targetRgb = getActiveRgb();
      let currentRgb: [number, number, number] = [...targetRgb];

      // alpha boost — dark-on-light reads dimmer at the same alpha, so light
      // mode multiplies line alpha to stay visible. Re-read on resize.
      const boostVal = () => {
        const v = parseFloat(
          getComputedStyle(document.documentElement)
            .getPropertyValue("--field-alpha-boost")
            .trim(),
        );
        return Number.isFinite(v) && v > 0 ? v : 1;
      };
      let boost = boostVal();

      let w = 0;
      let h = 0;
      let dpr = 1;
      let raf = 0;
      let running = false;

      // mouse target + smoothed position
      const mouse = { tx: -9999, ty: -9999, x: -9999, y: -9999 };

      const LINES = [
        { y: 0.3, amp: 14, freq: 0.008, speed: 0.25, alpha: 0.35, width: 1 },
        { y: 0.5, amp: 22, freq: 0.006, speed: 0.18, alpha: 0.25, width: 1.2 },
        { y: 0.7, amp: 10, freq: 0.011, speed: 0.32, alpha: 0.20, width: 1 },
      ];

      const build = () => {
        dpr = Math.min(window.devicePixelRatio || 1, 2);
        const rect = this.getBoundingClientRect();
        w = rect.width;
        h = rect.height;
        canvas.width = Math.floor(w * dpr);
        canvas.height = Math.floor(h * dpr);
        canvas.style.width = `${w}px`;
        canvas.style.height = `${h}px`;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      };

      const draw = (t: number) => {
        ctx.clearRect(0, 0, w, h);
        const time = t / 1000;

        // Smoothly lerp current RGB towards target platform RGB
        currentRgb[0] += (targetRgb[0] - currentRgb[0]) * 0.08;
        currentRgb[1] += (targetRgb[1] - currentRgb[1]) * 0.08;
        currentRgb[2] += (targetRgb[2] - currentRgb[2]) * 0.08;

        const colorStr = `${Math.round(currentRgb[0])}, ${Math.round(currentRgb[1])}, ${Math.round(currentRgb[2])}`;

        // smooth mouse position toward target (lerp 0.12)
        mouse.x += (mouse.tx - mouse.x) * 0.12;
        mouse.y += (mouse.ty - mouse.y) * 0.12;
        const hasMouse = mouse.tx > -9000;

        // soft colored bloom at cursor — matches selected platform
        if (hasMouse) {
          const bloomR = 190;
          const grad = ctx.createRadialGradient(
            mouse.x,
            mouse.y,
            0,
            mouse.x,
            mouse.y,
            bloomR,
          );
          grad.addColorStop(0, `rgba(${colorStr}, ${0.07 * boost})`);
          grad.addColorStop(0.5, `rgba(${colorStr}, ${0.02 * boost})`);
          grad.addColorStop(1, `rgba(${colorStr}, 0)`);
          ctx.fillStyle = grad;
          ctx.fillRect(mouse.x - bloomR, mouse.y - bloomR, bloomR * 2, bloomR * 2);
        }

        for (const line of LINES) {
          const baseY = h * line.y;
          ctx.beginPath();
          ctx.moveTo(0, baseY);
          for (let x = 0; x <= w; x += 4) {
            let y =
              baseY +
              Math.sin(x * line.freq + time * line.speed * Math.PI * 2) *
                line.amp;

            // mouse displacement: lines bend toward cursor with a gaussian falloff
            if (hasMouse) {
              const dx = x - mouse.x;
              const dy = baseY - mouse.y;
              const dist2 = dx * dx + dy * dy;
              const falloff = Math.exp(-dist2 / (2 * 120 * 120)); // sigma=120px
              // pull line toward cursor y, scaled by falloff
              y += (mouse.y - baseY) * falloff * 0.35;
              // also boost amplitude near cursor for a "ripple" effect
              y += Math.sin(time * 4 + x * 0.05) * 6 * falloff;
            }
            ctx.lineTo(x, y);
          }
          // lines brighten slightly near the cursor — global alpha bump
          const alpha = hasMouse ? line.alpha + 0.08 : line.alpha;

          // soft outer glow stroke
          ctx.strokeStyle = `rgba(${colorStr}, ${Math.min(alpha * boost * 0.45, 0.45)})`;
          ctx.lineWidth = line.width * 2.4;
          ctx.stroke();

          // core crisp stroke
          ctx.strokeStyle = `rgba(${colorStr}, ${Math.min(alpha * boost * 1.15, 0.9)})`;
          ctx.lineWidth = line.width;
          ctx.stroke();
        }
      };

      const drawStatic = () => {
        ctx.clearRect(0, 0, w, h);
        const colorStr = `${Math.round(targetRgb[0])}, ${Math.round(targetRgb[1])}, ${Math.round(targetRgb[2])}`;
        for (const line of LINES) {
          const baseY = h * line.y;
          ctx.beginPath();
          ctx.moveTo(0, baseY);
          for (let x = 0; x <= w; x += 4) {
            const y = baseY + Math.sin(x * line.freq) * line.amp;
            ctx.lineTo(x, y);
          }
          ctx.strokeStyle = `rgba(${colorStr}, ${line.alpha * 0.8 * boost})`;
          ctx.lineWidth = line.width;
          ctx.stroke();
        }
      };

      const loop = (t: number) => {
        draw(t);
        raf = requestAnimationFrame(loop);
      };
      const start = () => {
        if (running || reduced) return;
        running = true;
        raf = requestAnimationFrame(loop);
      };
      const stop = () => {
        running = false;
        cancelAnimationFrame(raf);
      };

      const onResize = () => {
        boost = boostVal();
        build();
        if (reduced) drawStatic();
      };

      const onPlatformChange = (e: Event) => {
        const evt = e as CustomEvent<{ rgb?: number[]; rgbStr?: string }>;
        if (evt.detail?.rgb && Array.isArray(evt.detail.rgb) && evt.detail.rgb.length === 3) {
          targetRgb = [evt.detail.rgb[0], evt.detail.rgb[1], evt.detail.rgb[2]];
        } else if (evt.detail?.rgbStr) {
          targetRgb = parseRgb(evt.detail.rgbStr);
        }
        if (reduced) {
          currentRgb = [...targetRgb];
          drawStatic();
        }
      };

      window.addEventListener("platform:change", onPlatformChange);
      this.cleanupFns.push(() => window.removeEventListener("platform:change", onPlatformChange));

      // track mouse position relative to the wrapper.
      // We listen on `window` (not the wrapper) because the wrapper has
      // pointer-events-none so it doesn't block clicks on the CTA above.
      const onMouseMove = (e: MouseEvent) => {
        const rect = this.getBoundingClientRect();
        const rx = e.clientX - rect.left;
        const ry = e.clientY - rect.top;
        // only track if the cursor is within the wrapper (with a margin)
        if (rx >= -50 && rx <= rect.width + 50 && ry >= -50 && ry <= rect.height + 50) {
          mouse.tx = rx;
          mouse.ty = ry;
        } else {
          // cursor left the wrapper — drift the smoothed pos off-screen too
          mouse.tx = -9999;
          mouse.ty = -9999;
        }
      };

      build();
      window.addEventListener("resize", onResize);
      this.cleanupFns.push(() => window.removeEventListener("resize", onResize));

      if (reduced) {
        drawStatic();
      } else {
        // Start immediately if already in viewport on connect —
        // IntersectionObserver only fires on changes.
        const rect = this.getBoundingClientRect();
        const vh = window.innerHeight || document.documentElement.clientHeight;
        if (rect.top < vh && rect.bottom > 0) {
          start();
        }
        const io = new IntersectionObserver(
          ([entry]) => (entry.isIntersecting ? start() : stop()),
          { threshold: 0 },
        );
        io.observe(this);
        // only track mouse on fine-pointer devices (skip touch)
        if (finePointer) {
          window.addEventListener("mousemove", onMouseMove, { passive: true });
        }
        this.cleanupFns.push(() => {
          stop();
          io.disconnect();
          if (finePointer) {
            window.removeEventListener("mousemove", onMouseMove);
          }
        });
      }
    }

    disconnectedCallback() {
      this.cleanupFns.forEach((fn) => fn());
      this.cleanupFns = [];
    }
  }

  customElements.define("ambient-signal", AmbientSignalEl);
</script>
