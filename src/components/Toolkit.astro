---
import { localeFromPath } from "../lib/i18n";
import { useTranslations } from "../config/i18n";
/**
 * Toolkit — periodic-table-style stack grid (gorix-inspired).
 *
 *  - each tool is a cell: per-category ID, verified logo when available, name
 *    (no experience-years display — the per-category ID is the only number)
 *  - cells grouped by category into 3-col mini-grids with "// label" headers
 *  - square filter controls and a dashed frame that follows the selected group
 *  - spotlight hover: hovering one cell dims the rest (gorix-style)
 *  - brand color drives each cell's border (faint tint at rest, full
 *    color + glow on hover)
 *
 *  ── Hover-for-description ──────────────────────────────────────────
 *  Cells that carry a `tool.description` reveal it directly on hover —
 *  no click, no tooltip-hint, no popover. A small frosted panel slides
 *  up above the cell showing the tool name + the full note. A tiny amber
 *  dot in the top-right of a cell marks it as having a note. Cells
 *  without a description are plain (logo + name already on the tile).
 *
 *  ── Click-to-toggle (mobile + desktop) ─────────────────────────────
 *  On touch devices there is no hover, so the description was
 *  unreachable. Clicking a cell with a note TOGGLES the description
 *  open/closed. When open, the cell gets the same expanded visual
 *  effect as hover (scale 1.22, spotlight dim, bright border + glow)
 *  via an `is-active` class on the button + `is-open` on the wrapper.
 *
 *  ── Close behaviors ────────────────────────────────────────────────
 *    • click the cell again -> toggle closed
 *    • Escape key -> close (a11y)
 *    • clicking another cell anywhere in the toolkit -> the first closes
 *      (only one open at a time, managed by the web component)
 *    • tapping outside or moving focus away -> close
 *    • hovering away does NOT close a toggled-open cell
 */
import { toolGroups as sourceGroups } from "../config/toolkit";
import { technologies, type Technology } from "../config/technologies";
import Section from "./primitives/Section.astro";
import SectionLabel from "./primitives/SectionLabel.astro";
import Reveal from "./primitives/Reveal.astro";
import TechIcon from "./icons/TechIcon.astro";

const locale = localeFromPath(Astro.url.pathname);
const t = useTranslations(locale);
const toolGroups = sourceGroups.map((group) => ({ ...group, label: t(group.label) }));

const filters = [
  { id: "all", label: t("all") },
  ...toolGroups.map((g) => ({ id: g.id, label: g.label })),
];
const pad = (n: number) => String(n).padStart(2, "0");

---

<toolkit-grid>
  <Section id="toolkit" class="bg-[var(--bg-soft)]">
    <div class="wrap">
      <Reveal>
        <SectionLabel>{t("toolkit")}</SectionLabel>
      </Reveal>
      <Reveal delay={80}>
        <h2 class="sec-title mt-3">{t("what's in my toolstack")}</h2>
      </Reveal>

      <Reveal delay={180}>
        <div class="mt-8 flex w-full justify-center">
          <div
            class="inline-flex w-fit max-w-full flex-wrap items-center justify-center gap-y-1"
          >
            {
              filters.map((f, i) => (
                <button
                  type="button"
                  data-filter={f.id}
                  class="filter-btn flex min-h-[44px] min-w-[44px] items-center gap-2.5 rounded-[10px] px-3 py-2 font-sans text-xs tracking-[0.06em] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--signal)]/60"
                  aria-pressed={i === 0 ? "true" : "false"}
                >
                  <span class="filter-mark" aria-hidden="true"></span>
                  <span>{f.label}</span>
                </button>
              ))
            }
          </div>
        </div>
      </Reveal>

      <!-- ── groups ───────────────────────────────────────────── -->
      <div
        class="toolkit-groups relative mx-auto mt-10 flex max-w-6xl flex-wrap justify-center gap-x-8 gap-y-10 p-3 sm:gap-x-10"
        data-groups
      >
        <span class="group-indicator" data-group-indicator aria-hidden="true" style="opacity: 0;"></span>
        {
          toolGroups.map((group, groupIdx) => (
            <div data-group={group.id} class="relative z-10 transition-opacity duration-[450ms] [transition-timing-function:var(--ease)] opacity-100">
              <h3 class="mb-3 flex max-w-[228px] items-center gap-2 font-mono text-xs tracking-[0.12em] uppercase">
                <span class="text-[var(--ink-muted)]">// {group.label}</span>
                <span class="h-px w-6 bg-[var(--ink-dim)]/40" aria-hidden="true" />
                <span class="text-[var(--ink-dim)]">{group.tools.length}</span>
              </h3>
              <div class="toolkit-tiles group/tiles grid gap-1.5">
                {group.tools.map((toolId, idx) => {
                  const source: Technology = technologies[toolId];
                  const tool = { ...source, description: source.description ? t(source.description) : undefined };
                  const hasNote = !!tool.description;
                  return (
                    <div class={`group/cell relative ${hasNote ? "has-note" : ""}`} data-tk-cell>
                      <button
                        type="button"
                        data-cell={`${groupIdx}:${idx}`}
                        aria-label={`${tool.label}${hasNote ? t(" — click to toggle notes") : ""}`}
                        title={tool.label}
                        aria-expanded={hasNote ? "false" : undefined}
                        aria-controls={hasNote ? `tool-note-${toolId}` : undefined}
                        aria-describedby={hasNote ? `tool-note-${toolId}` : undefined}
                        class="tk-cell relative flex h-[72px] w-[72px] flex-col justify-between overflow-hidden rounded-[9px] p-1.5 text-start focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--signal)]/60"
                      >
                        {/* per-category incrementing ID — top-left, zero-padded.
                            The only number on the cell. */}
                        <span class="font-sans text-[10px] leading-none tabular-nums text-[var(--ink)]">
                          {pad(idx + 1)}
                        </span>
                        {/* logo — center. The colored TechIcon is the ONE
                            exception to gorix's monochrome chrome. */}
                        <span class="flex w-full flex-1 items-center justify-center">
                          {tool.icon ? <TechIcon technology={toolId} size={20} /> : (
                            <span class="w-full break-words text-center font-sans text-[11px] leading-tight text-[var(--ink-muted)]">{tool.label}</span>
                          )}
                        </span>
                        {/* Tools without verified artwork use their full name. */}
                        {tool.icon && <span class="line-clamp-2 w-full text-center font-sans text-[11px] leading-tight text-[var(--ink-muted)]">
                          {tool.label}
                        </span>}
                        {/* has-note indicator — tiny amber dot, top-right.
                            Grows + glows brighter when the cell is open. */}
                        {hasNote && (
                          <span
                            aria-hidden="true"
                            class="tk-note-dot absolute end-1 top-1 h-1 w-1 rounded-full bg-[var(--signal)] transition-[box-shadow] [transition-duration:var(--transition-fast)]"
                            style="box-shadow: 0 0 6px var(--signal-glow);"
                          />
                        )}
                      </button>

                      {/* Align notes to the three-column grid to stay inside narrow screens. */}
                      {hasNote && (
                        <div
                          role="tooltip"
                          id={`tool-note-${toolId}`}
                          style={`left: ${-78 * (idx % 3)}px;`}
                          class="note-panel pointer-events-none absolute top-full z-40 mt-2 w-[228px] translate-y-1 opacity-0 transition-[opacity,transform] [transition-duration:240ms] [transition-timing-function:var(--ease)] group-hover/cell:translate-y-0 group-hover/cell:opacity-100 group-[.is-open]/cell:translate-y-0 group-[.is-open]/cell:opacity-100"
                        >
                          <div
                            class="overflow-hidden rounded-[var(--radius-sm)] border border-[var(--glass-border-soft)] bg-[var(--glass-bg-strong)] p-3.5 backdrop-blur-xl"
                            style="box-shadow: var(--tk-panel-shadow), inset 0 1px 0 rgba(255,255,255,0.06);"
                          >
                            <div class="flex items-center gap-2">
                              <TechIcon technology={toolId} size={16} />
                              <span class="font-sans text-[0.88rem] font-medium text-[var(--ink)]">
                                {tool.label}
                              </span>
                            </div>
                            <div
                              aria-hidden="true"
                              class="mt-2 h-px w-full bg-[var(--line-strong)]"
                            />
                            <p class="mt-2 font-sans text-[0.84rem] leading-[1.6] text-[var(--ink-muted)]">
                              {tool.description}
                            </p>
                          </div>
                          <span
                            aria-hidden="true"
                            style={`left: ${32 + 78 * (idx % 3)}px;`}
                            class="absolute -top-1 h-2 w-2 -rotate-45 border-l border-t border-[var(--glass-border-soft)] bg-[var(--glass-bg-strong)]"
                          />
                        </div>
                      )}
                    </div>
                  );
                })}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </Section>
</toolkit-grid>

<script>
  import { playSound } from "../scripts/sound-init";

  class ToolkitGridEl extends HTMLElement {
    private cleanupFns: (() => void)[] = [];
    private filter = "all";
    private activeCell: string | null = null;

    connectedCallback() {
      const events = new AbortController();
      const { signal } = events;
      this.cleanupFns.push(() => events.abort());
      const filterBtns = Array.from(
        this.querySelectorAll<HTMLButtonElement>("[data-filter]"),
      );
      const indicator = this.querySelector<HTMLElement>("[data-group-indicator]")!;
      const groups = Array.from(this.querySelectorAll<HTMLElement>("[data-group]"));
      const cells = Array.from(this.querySelectorAll<HTMLButtonElement>("[data-cell]"));
      const mobile = window.matchMedia("(max-width: 767px)");
      const motion = window.matchMedia("(prefers-reduced-motion: reduce)");
      const groupsArea = this.querySelector<HTMLElement>("[data-groups]")!;
      let filterAnimation: Animation | undefined;
      this.cleanupFns.push(() => filterAnimation?.cancel());
      this.filter = mobile.matches ? "backend" : "all";

      // Mobile filters hide other groups; desktop keeps the spotlight layout.
      const renderFilters = () => {
        filterBtns.forEach((btn) => {
          const isActive = btn.dataset.filter === this.filter;
          btn.setAttribute("aria-pressed", String(isActive));
        });
        groups.forEach((g) => {
          const excluded = this.filter !== "all" && this.filter !== g.dataset.group;
          g.hidden = mobile.matches && excluded;
          const dimmed = !mobile.matches && excluded;
          g.classList.toggle("opacity-25", dimmed);
          g.classList.toggle("opacity-100", !dimmed);
        });
      };

      const measureFrame = () => {
        indicator.style.opacity = this.filter === "all" ? "0" : "1";
        if (this.filter === "all") return;
        const group = groups.find((g) => g.dataset.group === this.filter);
        if (!group) return;
        const start = getComputedStyle(groupsArea).direction === "rtl"
          ? groupsArea.clientWidth - group.offsetLeft - group.offsetWidth
          : group.offsetLeft;
        indicator.style.insetInlineStart = `${start - 12}px`;
        indicator.style.insetBlockStart = `${group.offsetTop - 12}px`;
        indicator.style.inlineSize = `${group.offsetWidth + 24}px`;
        indicator.style.blockSize = `${group.offsetHeight + 24}px`;
      };

      const measure = () => {
        renderFilters();
        measureFrame();
      };

      const applyFilter = (id: string) => {
        if (id === this.filter) return;
        const previous = filterBtns.findIndex((btn) => btn.dataset.filter === this.filter);
        const next = filterBtns.findIndex((btn) => btn.dataset.filter === id);
        closeActive();
        filterAnimation?.cancel();
        this.filter = id;
        measure();
        if (mobile.matches && !motion.matches) {
          filterAnimation = groupsArea.animate([
            { transform: `translateY(${next > previous ? 24 : -24}px)`, opacity: 0 },
            { transform: "translateY(0)", opacity: 1 },
          ], { duration: 260, easing: "cubic-bezier(0.16, 1, 0.3, 1)" });
        }
      };

      filterBtns.forEach((btn) => {
        btn.addEventListener("mouseenter", () => playSound("hover"), { signal });
        btn.addEventListener("click", () => {
          applyFilter(btn.dataset.filter ?? "all");
          playSound("click");
        }, { signal });
      });

      window.addEventListener("resize", measure, { signal });
      mobile.addEventListener("change", () => {
        closeActive();
        filterAnimation?.cancel();
        measure();
      }, { signal });
      const observer = new ResizeObserver(measureFrame);
      observer.observe(groupsArea);
      groups.forEach((group) => observer.observe(group));
      this.cleanupFns.push(() => observer.disconnect());
      document.fonts.ready.then(() => {
        if (!signal.aborted) measure();
      });
      motion.addEventListener("change", () => {
        if (motion.matches) filterAnimation?.cancel();
      }, { signal });

      // ── cells: hover sound + click-to-toggle notes ───────────────
      const closeActive = () => {
        if (!this.activeCell) return;
        const prev = this.querySelector<HTMLElement>(
          `[data-cell="${this.activeCell}"]`,
        );
        prev?.classList.remove("is-active");
        prev?.setAttribute("aria-expanded", "false");
        prev?.closest("[data-tk-cell]")?.classList.remove("is-open");
        const dot = prev?.querySelector<HTMLElement>(".tk-note-dot");
        if (dot) {
          dot.className =
            "tk-note-dot absolute end-1 top-1 h-1 w-1 rounded-full bg-[var(--signal)] transition-[box-shadow] [transition-duration:var(--transition-fast)]";
          dot.setAttribute(
            "style",
            "box-shadow: 0 0 6px var(--signal-glow);",
          );
        }
        this.activeCell = null;
      };

      const toggleCell = (id: string) => {
        if (this.activeCell === id) {
          closeActive();
          return;
        }
        closeActive();
        this.activeCell = id;
        const cell = this.querySelector<HTMLElement>(`[data-cell="${id}"]`);
        cell?.classList.add("is-active");
        cell?.setAttribute("aria-expanded", "true");
        cell?.closest("[data-tk-cell]")?.classList.add("is-open");
        const dot = cell?.querySelector<HTMLElement>(".tk-note-dot");
        if (dot) {
          dot.className =
            "tk-note-dot absolute end-1 top-1 h-1.5 w-1.5 rounded-full bg-[var(--signal)] transition-[box-shadow] [transition-duration:var(--transition-fast)]";
          dot.setAttribute(
            "style",
            "box-shadow: 0 0 10px var(--signal-glow), 0 0 4px var(--signal);",
          );
        }
      };

      cells.forEach((cell) => {
        cell.addEventListener("mouseenter", () => playSound("hover"), { signal });
        cell.addEventListener("click", () => {
          const wrapper = cell.closest("[data-tk-cell]");
          if (!wrapper?.classList.contains("has-note")) {
            closeActive();
            return;
          }
          toggleCell(cell.dataset.cell ?? "");
          playSound("click");
        }, { signal });
      });

      document.addEventListener("pointerdown", (event) => {
        const active = this.querySelector("[data-tk-cell].is-open");
        if (active && !active.contains(event.target as Node)) closeActive();
      }, { signal });
      this.addEventListener("focusout", (event) => {
        const active = this.querySelector("[data-tk-cell].is-open");
        if (active?.contains(event.target as Node) && !active.contains(event.relatedTarget as Node | null)) {
          closeActive();
        }
      }, { signal });

      // Escape closes an open cell (a11y)
      const onKey = (e: KeyboardEvent) => {
        if (e.key === "Escape") closeActive();
      };
      window.addEventListener("keydown", onKey);
      this.cleanupFns.push(() => window.removeEventListener("keydown", onKey));
      measure();
    }

    disconnectedCallback() {
      this.cleanupFns.forEach((fn) => fn());
      this.cleanupFns = [];
    }
  }

  customElements.define("toolkit-grid", ToolkitGridEl);
</script>

<style>
  .toolkit-tiles {
    grid-template-columns: repeat(3, 72px);
    grid-auto-rows: 72px;
  }
  @media (max-width: 767px) {
    .toolkit-groups {
      flex-direction: column;
      flex-wrap: nowrap;
      align-items: center;
    }
    .toolkit-tiles {
      grid-auto-rows: minmax(72px, auto);
      align-items: start;
    }
    /* Expanded notes stay in the page flow alongside the mobile cells. */
    .note-panel {
      display: none;
    }
    [data-tk-cell].is-open .note-panel {
      display: block;
      position: relative;
      top: auto;
      transform: none;
      opacity: 1;
      pointer-events: auto;
    }
  }
  .filter-btn {
    color: color-mix(in srgb, var(--ink) 55%, transparent);
    background: transparent;
    transition: color 150ms var(--ease), transform 150ms var(--ease);
  }
  .filter-btn:hover {
    color: color-mix(in srgb, var(--ink) 80%, transparent);
  }
  .filter-btn:active {
    transform: translateY(1px);
  }
  .filter-mark {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    inline-size: 18px;
    block-size: 18px;
    border-radius: 6px;
    border: 1px solid var(--filter-border);
    background: var(--filter-bg);
    box-shadow: inset 0 1px 2px var(--filter-inset);
    transition:
      border-color 150ms var(--ease),
      background-color 150ms var(--ease),
      box-shadow 150ms var(--ease);
  }
  .filter-btn:hover .filter-mark {
    border-color: var(--filter-border-hover);
  }
  .filter-mark::after {
    content: "";
    inline-size: 6px;
    block-size: 6px;
    border-radius: 2px;
    background: var(--bg);
    transform: scale(0);
    transition: transform 150ms var(--ease);
  }
  .filter-btn[aria-pressed="true"] {
    color: var(--ink);
  }
  .filter-btn[aria-pressed="true"] .filter-mark {
    border-color: color-mix(in srgb, var(--ink) 30%, transparent);
    background: var(--ink);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.65), inset 0 -2px 0 rgb(0 0 0 / 0.22);
  }
  .filter-btn[aria-pressed="true"] .filter-mark::after {
    transform: scale(1);
  }
  .group-indicator {
    pointer-events: none;
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 0;
    border: 2px dashed color-mix(in srgb, var(--ink) 20%, transparent);
    background: color-mix(in srgb, var(--ink) 2%, transparent);
    border-radius: 21px;
    transition:
      inset-inline-start 450ms var(--ease),
      inset-block-start 450ms var(--ease),
      inline-size 450ms var(--ease),
      block-size 450ms var(--ease),
      opacity 450ms var(--ease);
  }
  @media (prefers-reduced-motion: reduce) {
    .note-panel,
    .filter-btn,
    .filter-mark,
    .filter-mark::after,
    .group-indicator,
    [data-group] {
      transition: none !important;
    }
  }
</style>
