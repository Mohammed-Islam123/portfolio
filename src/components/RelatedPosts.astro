---
import type { Post } from "../lib/blog";
import { formatDate } from "../lib/blog";

interface Props { posts: Post[]; }
const { posts } = Astro.props;
---

{posts.length > 0 && (
  <section class="related-posts" aria-labelledby="related-posts-heading">
    <h2 id="related-posts-heading" class="mono-label">Related posts</h2>
    <div class="related-posts__grid">
      {posts.map((post) => (
        <a href={`/blog/${post.id}/`}>
          <span>{formatDate(post.data.pubDate)}</span>
          <strong>{post.data.title}</strong>
          <small>{post.data.description}</small>
        </a>
      ))}
    </div>
  </section>
)}

<style>
  .related-posts { margin-top: 3.5rem; padding-top: 2rem; border-top: 1px solid var(--line-soft); }
  .related-posts__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr)); gap: 0.8rem; margin-top: 1rem; }
  .related-posts a { display: grid; gap: 0.5rem; min-width: 0; padding: 1rem; border: 1px solid var(--line); border-radius: var(--radius-sm); background: var(--surface); color: inherit; text-decoration: none; transition: transform var(--transition-fast), border-color var(--transition-fast), background var(--transition-fast); }
  .related-posts a:hover { transform: translateY(-2px); border-color: var(--ink-muted); background: var(--surface-2); }
  .related-posts span { font-family: var(--font-mono); font-size: 0.6875rem; color: var(--ink-dim); }
  .related-posts strong { font-family: var(--font-display); font-size: 1rem; line-height: 1.2; color: var(--ink); }
  .related-posts small { color: var(--ink-muted); line-height: 1.5; }
</style>
