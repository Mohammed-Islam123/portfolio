---
import { technologies, type Technology, type TechnologyId } from "../../config/technologies";

interface Props {
  technology: TechnologyId;
  size?: number;
  class?: string;
}

const { technology, size = 22, class: className } = Astro.props;
const tech: Technology = technologies[technology];
const icon = tech.icon;
---

{
  icon && ("src" in icon ? (
    <>
      <img
        class:list={["object-contain", className, { "hidden dark:block": !!icon.lightSrc }]}
        src={icon.src}
        width={size}
        height={size}
        alt=""
        aria-hidden="true"
        draggable="false"
      />
      {icon.lightSrc && <img
        class:list={["object-contain dark:hidden", className]}
        src={icon.lightSrc}
        width={size}
        height={size}
        alt=""
        aria-hidden="true"
        draggable="false"
      />}
    </>
  ) : (
    <svg
      class={className}
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill={tech.monochrome ? "currentColor" : `#${icon.hex}`}
      aria-hidden="true"
    >
      <path d={icon.path} />
    </svg>
  ))
}
