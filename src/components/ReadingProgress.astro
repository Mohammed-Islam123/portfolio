<!--
  ReadingProgress — thin amber progress bar fixed at the top of the viewport.
  Shows reading progress as a percentage of the page scrolled.
  Respects reduced-motion.
-->
<reading-progress>
  <div
    class="rp-bar fixed top-0 start-0 z-[60] h-[2px] w-full origin-[0_50%] rtl:origin-[100%_50%]"
    style="transform: scaleX(0); background: linear-gradient(90deg, var(--signal) 0%, var(--signal-2) 100%); box-shadow: 0 0 8px var(--signal-glow), 0 1px 2px rgba(0,0,0,0.3);"
    aria-hidden="true"
    hidden
  ></div>
</reading-progress>

<script>
  class ReadingProgressEl extends HTMLElement {
    private cleanupFns: (() => void)[] = [];

    connectedCallback() {
      const mq = window.matchMedia("(prefers-reduced-motion: reduce)");
      const bar = this.querySelector<HTMLElement>(".rp-bar");
      if (!bar) return;

      let raf = 0;
      let lastProgress = -1;
      const update = () => {
        const doc = document.documentElement;
        const scrollHeight = doc.scrollHeight - doc.clientHeight;
        const progress = mq.matches || scrollHeight <= 0 ? 0 : Math.max(0, Math.min(1, window.scrollY / scrollHeight));
        if (progress === lastProgress) return;
        lastProgress = progress;
        bar.style.transform = `scaleX(${progress})`;
        bar.hidden = progress <= 0;
      };
      const onScroll = () => {
        if (!mq.matches && !raf) raf = requestAnimationFrame(() => {
          raf = 0;
          update();
        });
      };
      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", onScroll, { passive: true });
      mq.addEventListener("change", update);
      update();
      this.cleanupFns.push(() => {
        window.removeEventListener("scroll", onScroll);
        window.removeEventListener("resize", onScroll);
        mq.removeEventListener("change", update);
        cancelAnimationFrame(raf);
      });
    }

    disconnectedCallback() {
      this.cleanupFns.forEach((fn) => fn());
      this.cleanupFns = [];
    }
  }

  customElements.define("reading-progress", ReadingProgressEl);
</script>
