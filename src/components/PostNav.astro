---
import type { Post } from "../lib/blog";
import UiIcon from "./icons/UiIcon.astro";

interface Props { previous: Post | null; next: Post | null; }
const { previous, next } = Astro.props;
---

{(previous || next) && (
  <nav class="post-nav" aria-label="Post navigation">
    {previous ? <a href={`/blog/${previous.id}/`}><span><UiIcon name="arrow-left" size={14} /> Previous</span><strong>{previous.data.title}</strong></a> : <span />}
    {next ? <a class="post-nav__next" href={`/blog/${next.id}/`}><span>Next <UiIcon name="arrow-right" size={14} /></span><strong>{next.data.title}</strong></a> : <span />}
  </nav>
)}

<style>
  .post-nav { display: grid; grid-template-columns: minmax(0, 1fr); gap: 0.8rem; margin-top: 2rem; padding-top: 2rem; border-top: 1px solid var(--line-soft); }
  .post-nav a { display: grid; gap: 0.45rem; min-width: 0; padding: 1rem; border: 1px solid var(--line); border-radius: var(--radius-sm); background: var(--surface); color: inherit; text-decoration: none; transition: transform var(--transition-fast), border-color var(--transition-fast), background var(--transition-fast); }
  .post-nav a:hover { transform: translateY(-2px); border-color: var(--ink-muted); background: var(--surface-2); }
  .post-nav span { display: inline-flex; align-items: center; gap: 0.35rem; font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-dim); }
  .post-nav strong { font-family: var(--font-display); line-height: 1.2; color: var(--ink); }
  .post-nav__next { text-align: right; justify-items: end; }
  @media (min-width: 640px) { .post-nav { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
