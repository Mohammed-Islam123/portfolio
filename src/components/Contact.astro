---
import { localeFromPath } from "../lib/i18n";
import { useTranslations } from "../config/i18n";
/**
 * Contact — closing CTA + interactive platform selector + footer bar.
 *  - Main sentence: "if you've made it this far,"
 *  - Interactive pill CTA with split action:
 *    - Left: "Say hi | [Icon] Platform" (opens contact link)
 *    - Right: Chevron dropdown button (toggles platform menu)
 *  - Platforms supported: WhatsApp, LinkedIn, Email, Telegram
 *  - Dynamic color glow: button outline and AmbientSignal moving lines
 *    change color dynamically based on the active platform.
 *  - Secondary profiles beneath: "or find me on" with GitHub, LinkedIn, and Portfolio.
 *  - AmbientSignal shader behind (reactive flowing sine lines).
 *  - Footer bar: copyright + sound toggle.
 */
import { getSiteConfig } from "../config/site";
import SectionLabel from "./primitives/SectionLabel.astro";
import Reveal from "./primitives/Reveal.astro";
import AmbientSignal from "./AmbientSignal.astro";
import SocialIcon from "./icons/SocialIcon.astro";
import UiIcon from "./icons/UiIcon.astro";

const buildYear = new Date().getFullYear();

const locale = localeFromPath(Astro.url.pathname);
const t = useTranslations(locale);
const siteConfig = getSiteConfig(locale);
const defaultPlatform = siteConfig.contactPlatforms[0];
---

<footer
  id="contact"
  class="relative mt-auto overflow-hidden border-t border-[var(--line-soft)] bg-[var(--bg)]"
>
  <!-- ambient shader with dynamic platform color -->
  <AmbientSignal class="opacity-75" />

  <div class="relative wrap py-[clamp(5rem,14vh,9rem)]">
    <Reveal>
      <SectionLabel>{t("contact")}</SectionLabel>
    </Reveal>

    <Reveal delay={80}>
      <div class="mt-10 flex flex-col items-center text-center">
        <!-- Main headline without 'say hi' -->
        <p
          class="contact-headline"
        >
          {siteConfig.contactCopy.headline}
        </p>

        <!-- ── Interactive Platform CTA Pill ─────────────────────── -->
        <contact-selector class="relative mt-8 block w-[17rem] max-w-full">
          <div
            class="contact-pill relative flex items-center rounded-full bg-[var(--surface)]"
            style={`--platform-rgb: ${defaultPlatform.colorRgb}; --platform-color: ${defaultPlatform.colorHex};`}
          >
            <!-- Primary Action Link: "Say hi | [Icon] Platform" -->
            <a
              href={defaultPlatform.href}
              target={defaultPlatform.href.startsWith("http") ? "_blank" : undefined}
              rel={defaultPlatform.href.startsWith("http") ? "noopener noreferrer" : undefined}
              data-action-link
              data-sound-hover
              data-sound-click
              aria-label={`${t("Say hi via")} ${defaultPlatform.label}`}
              class="contact-action flex min-h-12 min-w-0 flex-1 items-center gap-3 rounded-full py-3 pl-5 pr-3 text-[var(--ink)]"
            >
              <span class="whitespace-nowrap">
                {siteConfig.contactCopy.action}
              </span>
              <span aria-hidden="true" class="h-4 w-px shrink-0 bg-[var(--line-strong)]"></span>
              <span class="flex items-center gap-2">
                <span class="active-icon-wrapper flex items-center justify-center">
                  {
                    siteConfig.contactPlatforms.map((p, idx) => (
                      <span
                        data-icon-for={p.id}
                        class={idx === 0 ? "inline-flex items-center" : "hidden"}
                        style={`color: ${p.colorHex};`}
                      >
                        <SocialIcon name={p.icon} size={19} />
                      </span>
                    ))
                  }
                </span>
                <span
                  data-active-label
                  class="whitespace-nowrap"
                >
                  {defaultPlatform.label}
                </span>
              </span>
            </a>

            <!-- Dropdown Toggle Button: Chevron inside subtle circular button -->
            <div class="py-1 pr-1">
              <button
                type="button"
                data-dropdown-toggle
                aria-expanded="false"
                aria-controls="platform-dropdown"
                aria-haspopup="listbox"
                aria-label={`${t("Select contact platform, current:")} ${defaultPlatform.label}`}
                data-sound-hover
                data-sound-click
                class="contact-toggle flex h-11 w-11 items-center justify-center rounded-full"
              >
                <span class="chevron-icon inline-block">
                  <UiIcon name="chevron-down" size={18} />
                </span>
              </button>
            </div>
          </div>

          <!-- Dropdown Menu -->
          <div
            id="platform-dropdown"
            role="listbox"
            aria-label={t("Contact platforms")}
            hidden
            tabindex="-1"
            class="contact-dropdown absolute right-0 top-[calc(100%+8px)] z-40 w-52 max-w-full rounded-[var(--radius)] border border-[var(--line-strong)] bg-[var(--surface)] p-1.5"
          >
            {
              siteConfig.contactPlatforms.map((p, idx) => (
                <button
                  type="button"
                  role="option"
                  aria-selected={idx === 0 ? "true" : "false"}
                  tabindex={idx === 0 ? 0 : -1}
                  data-platform-id={p.id}
                  data-platform-label={p.label}
                  data-platform-href={p.href}
                  data-platform-rgb={p.colorRgb}
                  data-platform-hex={p.colorHex}
                  data-sound-hover
                  data-sound-click
                  class="platform-option flex min-h-11 w-full items-center gap-3 rounded-[var(--radius-sm)] px-3 py-2 text-left"
                >
                  <span class="shrink-0">
                    <SocialIcon name={p.icon} size={18} />
                  </span>
                  <span class="font-medium text-[var(--ink)]">{p.label}</span>
                </button>
              ))
            }
          </div>
        </contact-selector>

        <!-- ── Secondary Profiles: or find me on ─────────────────── -->
        <div class="contact-profiles mt-9 flex flex-col items-center gap-3">
          <p class="contact-profiles-label">{siteConfig.contactCopy.profiles}</p>
          <div class="flex flex-wrap items-center justify-center gap-3">
            {
              siteConfig.socialProfiles.map((s) => (
                <a
                  href={s.href}
                  target={s.href.startsWith("http") ? "_blank" : undefined}
                  rel={s.href.startsWith("http") ? "noopener noreferrer" : undefined}
                  data-sound-hover
                  data-sound-click
                  aria-label={s.label}
                  title={s.label}
                  class="contact-profile-link flex min-h-11 items-center justify-center gap-2 rounded-full border border-[var(--line)] px-4 py-2"
                >
                  {s.icon === "portfolio" ? (
                    <UiIcon name="arrow-up-right" size={18} />
                  ) : (
                    <SocialIcon name={s.icon} size={18} />
                  )}
                  <span>{s.label}</span>
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </Reveal>
  </div>

  <!-- ── footer bar ──────────────────────────────────────────── -->
  <div class="relative border-t border-[var(--line-soft)]">
    <div
      class="wrap flex flex-wrap items-center justify-between gap-3 py-4 font-mono text-xs text-[var(--ink-dim)]"
    >
      <div class="flex items-center gap-2">
        <span class="text-[var(--ink-muted)]">©</span>
        <span><span data-year>{buildYear}</span> {siteConfig.fullName}</span>
      </div>
      <div class="flex items-center gap-3">
        <sound-toggle>
          <span class="st-label sound-off" hidden>
            <span class="inline-block h-1.5 w-1.5 rounded-full bg-[var(--ink-dim)]"></span>
            {t("sound · off")}
          </span>
          <button type="button" class="st-btn hidden items-center gap-2 transition-colors hover:text-[var(--ink)] cursor-pointer">
            <span class="st-led inline-block h-1.5 w-1.5 rounded-full transition-[background-color,box-shadow] [transition-duration:var(--transition)]"></span>
            <span class="st-text">{t("sound · on")}</span>
          </button>
        </sound-toggle>
      </div>
    </div>
  </div>

  <!-- keep the footer year current in the visitor's year (the static
       HTML carries the build year as a no-JS fallback) -->
  <script is:inline data-astro-rerun>
    (function () {
      var el = document.querySelector("[data-year]");
      if (el) el.textContent = String(new Date().getFullYear());
    })();
  </script>
</footer>

<script>
  import { useTranslations } from "../config/i18n";
  const t = (message: string) => useTranslations(document.documentElement.lang === "fr" ? "fr" : "en")(message);
  import {
    isSoundOn,
    isSoundCapableNow,
    toggleSound,
    playSound,
    SOUND_SYNC_EVENT,
  } from "../scripts/sound-init";

  class SoundToggleEl extends HTMLElement {
    private events: AbortController | null = null;

    connectedCallback() {
      this.events?.abort();
      this.events = new AbortController();
      const options = { signal: this.events.signal };
      const disabled = this.querySelector<HTMLElement>(".sound-off");
      const btn = this.querySelector<HTMLButtonElement>(".st-btn");
      const led = this.querySelector<HTMLElement>(".st-led");
      const text = this.querySelector<HTMLElement>(".st-text");
      if (!disabled || !btn || !led || !text) return;

      if (!isSoundCapableNow()) {
        disabled.hidden = false;
        return;
      }
      btn.hidden = false;
      btn.classList.remove("hidden");
      btn.classList.add("flex");

      const render = () => {
        const on = isSoundOn();
        btn.setAttribute("aria-pressed", String(on));
        btn.setAttribute("aria-label", on ? t("turn sound off") : t("turn sound on"));
        led.className = `st-led inline-block h-1.5 w-1.5 rounded-full transition-[background-color,box-shadow] [transition-duration:var(--transition)] ${
          on
            ? "bg-[var(--ink)] shadow-[0_0_6px_rgba(255,255,255,0.4)]"
            : "bg-[var(--ink-dim)]"
        }`;
        text.textContent = t(on ? "sound · on" : "sound · off");
      };
      render();

      btn.addEventListener("click", () => {
        toggleSound();
      }, options);
      window.addEventListener(SOUND_SYNC_EVENT, render, options);

      // hover & click sound delegation within footer
      const footer = this.closest("footer");
      footer?.querySelectorAll("[data-sound-hover]").forEach((el) =>
        el.addEventListener("mouseenter", () => playSound("hover"), options),
      );
      footer?.querySelectorAll("[data-sound-click]").forEach((el) =>
        el.addEventListener("click", () => playSound("click"), options),
      );
    }

    disconnectedCallback() {
      this.events?.abort();
      this.events = null;
    }
  }

  class ContactSelectorEl extends HTMLElement {
    private events: AbortController | null = null;
    private isOpen = false;

    connectedCallback() {
      this.events?.abort();
      this.events = new AbortController();
      const { signal } = this.events;

      const pill = this.querySelector<HTMLElement>(".contact-pill");
      const toggleBtn = this.querySelector<HTMLButtonElement>("[data-dropdown-toggle]");
      const dropdown = this.querySelector<HTMLElement>("#platform-dropdown");
      const actionLink = this.querySelector<HTMLAnchorElement>("[data-action-link]");
      const activeLabel = this.querySelector<HTMLElement>("[data-active-label]");
      const chevronIcon = this.querySelector<HTMLElement>(".chevron-icon");
      const options = Array.from(this.querySelectorAll<HTMLButtonElement>(".platform-option"));
      const iconSpans = this.querySelectorAll<HTMLElement>("[data-icon-for]");

      if (!pill || !toggleBtn || !dropdown || !actionLink || !activeLabel) return;

      const setOpen = (open: boolean) => {
        this.isOpen = open;
        toggleBtn.setAttribute("aria-expanded", String(open));
        dropdown.hidden = !open;
        dropdown.inert = !open;
        chevronIcon?.classList.toggle("rotate-180", open);
        if (open) {
          const selected = options.find((opt) => opt.getAttribute("aria-selected") === "true");
          focusOption(selected ?? options[0]);
        }
      };

      const focusOption = (option: HTMLButtonElement | undefined) => {
        if (!option) return;
        options.forEach((opt) => { opt.tabIndex = opt === option ? 0 : -1; });
        option.focus({ preventScroll: true });
      };

      const selectPlatform = (opt: HTMLButtonElement) => {
        const id = opt.dataset.platformId;
        const label = opt.dataset.platformLabel;
        const href = opt.dataset.platformHref;
        const rgb = opt.dataset.platformRgb;
        const hex = opt.dataset.platformHex;

        if (!id || !label || !href || !rgb || !hex) return;

        // Update action link & label
        actionLink.href = href;
        actionLink.setAttribute("aria-label", `${t("Say hi via")} ${label}`);
        if (href.startsWith("http")) {
          actionLink.target = "_blank";
          actionLink.rel = "noopener noreferrer";
        } else {
          actionLink.removeAttribute("target");
          actionLink.removeAttribute("rel");
        }
        activeLabel.textContent = label;
        toggleBtn.setAttribute("aria-label", `${t("Select contact platform, current:")} ${label}`);

        // Update active icon
        iconSpans.forEach((span) => {
          if (span.dataset.iconFor === id) {
            span.classList.remove("hidden");
            span.classList.add("inline-flex", "items-center");
          } else {
            span.classList.add("hidden");
            span.classList.remove("inline-flex", "items-center");
          }
        });

        // Keep all platforms visible, including the selected option.
        options.forEach((btn) => {
          const selected = btn.dataset.platformId === id;
          btn.setAttribute("aria-selected", String(selected));
          btn.tabIndex = selected ? 0 : -1;
        });

        // Update glow styling on the pill
        pill.style.setProperty("--platform-rgb", rgb);
        pill.style.setProperty("--platform-color", hex);

        // Dispatch platform change event to AmbientSignal shader
        const rgbArr = rgb.split(",").map((s) => parseFloat(s.trim()));
        window.dispatchEvent(
          new CustomEvent("platform:change", {
            detail: { rgb: rgbArr, rgbStr: rgb, hex },
          }),
        );

        setOpen(false);
        toggleBtn.focus({ preventScroll: true });
      };

      toggleBtn.addEventListener(
        "click",
        (e) => {
          e.stopPropagation();
          setOpen(!this.isOpen);
        },
        { signal },
      );

      options.forEach((opt) => {
        opt.addEventListener(
          "click",
          (e) => {
            e.stopPropagation();
            selectPlatform(opt);
          },
          { signal },
        );
      });

      // Close on click outside
      document.addEventListener(
        "click",
        (e) => {
          if (this.isOpen && !this.contains(e.target as Node)) {
            setOpen(false);
          }
        },
        { signal },
      );

      this.addEventListener("focusout", (e) => {
        if (this.isOpen && !this.contains(e.relatedTarget as Node | null)) {
          setOpen(false);
        }
      }, { signal });

      this.addEventListener(
        "keydown",
        (e) => {
          if (e.key === "Escape" && this.isOpen) {
            e.preventDefault();
            e.stopPropagation();
            setOpen(false);
            toggleBtn.focus({ preventScroll: true });
            return;
          }
          if (e.key === "ArrowDown" || e.key === "ArrowUp") {
            if (!this.isOpen && e.target !== toggleBtn) return;
            e.preventDefault();
            if (!this.isOpen) {
              setOpen(true);
            } else {
              const index = options.indexOf(document.activeElement as HTMLButtonElement);
              const step = e.key === "ArrowDown" ? 1 : -1;
              focusOption(options[(index + step + options.length) % options.length]);
            }
          } else if (this.isOpen && (e.key === "Home" || e.key === "End")) {
            e.preventDefault();
            focusOption(e.key === "Home" ? options[0] : options.at(-1));
          }
        },
        { signal },
      );
      setOpen(false);
    }

    disconnectedCallback() {
      this.events?.abort();
      this.events = null;
      this.isOpen = false;
    }
  }

  customElements.define("sound-toggle", SoundToggleEl);
  customElements.define("contact-selector", ContactSelectorEl);
</script>
