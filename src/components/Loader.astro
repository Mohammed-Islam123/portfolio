---
import { localeFromPath } from "../lib/i18n";
import { useTranslations } from "../config/i18n";
interface Props {
  mode?: "home" | "article" | "generic";
  slug?: string;
}

const { mode = "generic", slug } = Astro.props;
const command =
  mode === "home"
    ? { prompt: "~/mohamed-islam $", text: "whoami" }
    : mode === "article" && slug
      ? { prompt: "~/blog $", text: `cat ${slug}.md` }
      : null;
const typeDuration = command
  ? mode === "home"
    ? 760
    : Math.max(500, command.text.length * 15)
  : 0;

const locale = localeFromPath(Astro.url.pathname);
const t = useTranslations(locale);
---

<noscript><style>.loader-overlay{display:none}</style></noscript>
<boot-loader data-mode={mode} style={command ? `--command-length:${Array.from(command.text).length};--command-width:${Array.from(command.text).length}ch;--type-duration:${typeDuration}ms` : undefined}>
  <div
    class="loader-overlay"
    role="dialog"
    aria-modal="true"
    aria-label={t("Loading portfolio")}
  >
    <div class="loader-terminal">
      {command && (
        <div class="loader-command-line" dir="ltr">
          <span class="loader-prompt">{command.prompt}</span>
          <span class="loader-command">
            <span class="loader-command-text">{command.text}</span>
            <span class="loader-cursor" aria-hidden="true"></span>
          </span>
        </div>
      )}
      <p class="loader-status">
        <span>{t("loading")}</span><span class="loader-dots" aria-hidden="true">…</span>
      </p>
    </div>
    <span class="sr-only" aria-live="polite" data-live>{t("Loading portfolio")}</span>
  </div>
</boot-loader>

<script is:inline>
  (() => {
    const loader = document.currentScript?.previousElementSibling;
    if (loader?.localName !== "boot-loader" || loader.hasAttribute("data-active")) return;
    document.documentElement.dataset.loaderState = "loading";
    // Release the static overlay if the component module never starts.
    window.setTimeout(() => {
      if (!loader.isConnected || loader.hasAttribute("data-active")) return;
      loader.remove();
      document.documentElement.dataset.loaderState = "dismissed";
      document.documentElement.classList.remove("loader-scroll-lock");
      window.dispatchEvent(new CustomEvent("loader:dismiss"));
      window.dispatchEvent(new CustomEvent("loader:statechange", { detail: { state: "dismissed" } }));
    }, 8000);
  })();
</script>

<script>
  let activeLoader: BootLoader | undefined;

  class BootLoader extends HTMLElement {
    private lifecycle = new AbortController();
    private removeTimer?: number;
    private holdTimer?: number;
    private ready = false;
    private commandReady = false;
    private dismissed = false;

    connectedCallback() {
      activeLoader?.cancel();
      this.lifecycle = new AbortController();
      this.ready = this.commandReady = this.dismissed = false;
      activeLoader = this;
      this.setAttribute("data-active", "");

      document.documentElement.dataset.loaderState = "loading";
      document.documentElement.classList.add("loader-scroll-lock");
      window.dispatchEvent(
        new CustomEvent("loader:statechange", { detail: { state: "loading" } }),
      );

      const isGeneric = this.dataset.mode === "generic";
      if (isGeneric || window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        this.markCommandComplete();
      } else {
        const animation = this.querySelector(".loader-command-text")?.getAnimations()
          .find((animation) => (animation as CSSAnimation).animationName === "loader-type");
        if (animation) {
          void animation.finished.then(
            () => this.markCommandComplete(),
            () => this.markCommandComplete(),
          );
        } else this.markCommandComplete();
      }

      const isClientNavigation =
        document.documentElement.dataset.clientNavigation === "true";
      if (isClientNavigation) {
        document.addEventListener("astro:page-load", () => void this.waitForAssets(), {
          once: true,
          signal: this.lifecycle.signal,
        });
      } else if (document.readyState === "complete") {
        void this.waitForAssets();
      } else {
        window.addEventListener("load", () => void this.waitForAssets(), {
          once: true,
          signal: this.lifecycle.signal,
        });
      }
    }

    private async waitForAssets() {
      const signal = this.lifecycle.signal;
      const portrait = document.querySelector<HTMLImageElement>("hero-section .hero-portrait");
      await Promise.allSettled([document.fonts.ready, ...(portrait ? [portrait.decode()] : [])]);
      if (signal.aborted || !this.isConnected) return;
      this.ready = true;
      this.dismissWhenReady();
    }

    private dismissWhenReady() {
      if (this.dismissed || !this.ready || !this.commandReady) return;
      this.dismiss();
    }

    private markCommandComplete() {
      if (this.dismissed || this.commandReady || this.holdTimer !== undefined) return;
      this.setAttribute("data-command-complete", "");
      if (this.dataset.mode === "generic") {
        this.commandReady = true;
        this.dismissWhenReady();
        return;
      }
      this.holdTimer = window.setTimeout(() => {
        this.holdTimer = undefined;
        this.commandReady = true;
        this.dismissWhenReady();
      }, 1000);
    }

    private cancel() {
      this.dismissed = true;
      this.lifecycle.abort();
      window.clearTimeout(this.removeTimer);
      window.clearTimeout(this.holdTimer);
      this.holdTimer = undefined;
    }

    private dismiss() {
      if (this.dismissed) return;
      this.dismissed = true;
      this.lifecycle.abort();
      document.documentElement.dataset.loaderState = "dismissed";
      this.querySelector<HTMLElement>(".loader-overlay")?.classList.add("is-dismissing");
      window.dispatchEvent(new CustomEvent("loader:dismiss"));
      window.dispatchEvent(
        new CustomEvent("loader:statechange", { detail: { state: "dismissed" } }),
      );
      const duration = window.matchMedia("(prefers-reduced-motion: reduce)").matches ? 160 : 420;
      this.removeTimer = window.setTimeout(() => {
        if (activeLoader === this) {
          activeLoader = undefined;
          document.documentElement.classList.remove("loader-scroll-lock");
        }
        this.remove();
      }, duration);
    }

    disconnectedCallback() {
      this.removeAttribute("data-active");
      this.cancel();
      if (activeLoader === this) {
        activeLoader = undefined;
        document.documentElement.classList.remove("loader-scroll-lock");
      }
    }
  }

  if (!customElements.get("boot-loader")) {
    customElements.define("boot-loader", BootLoader);
  }
</script>

<style>
  .loader-overlay {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: center;
    background: var(--bg);
    color: var(--ink);
    transition: opacity 420ms var(--ease), transform 420ms var(--ease);
  }

  .loader-terminal {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    inline-size: max-content;
    min-inline-size: min(28rem, calc(100vw - 3rem));
    max-inline-size: calc(100vw - 3rem);
    font-family: ui-monospace, monospace;
    font-size: clamp(0.9rem, 2.4vw, 1.2rem);
    letter-spacing: 0.03em;
  }

  .loader-command-line,
  .loader-status {
    display: flex;
    align-items: center;
    margin: 0;
  }

  .loader-prompt,
  .loader-status { color: var(--ink-dim); }

  .loader-command-line {
    align-items: baseline;
    column-gap: 1ch;
    overflow-x: auto;
    white-space: nowrap;
    scrollbar-width: thin;
  }

  .loader-prompt,
  .loader-command {
    flex-shrink: 0;
  }

  .loader-status {
    opacity: 0;
    transform: translateY(0.25rem);
    animation: loader-status-in 180ms var(--ease) var(--type-duration, 0ms) both;
  }

  .loader-command {
    position: relative;
    display: inline-grid;
    white-space: nowrap;
    padding-inline-end: 0.8ch;
    letter-spacing: normal;
    color: var(--ink);
  }

  .loader-command-text {
    display: inline-block;
    animation: loader-type var(--type-duration) steps(var(--command-length), end) both;
  }

  boot-loader[data-command-complete] .loader-command-text {
    clip-path: none;
  }

  .loader-cursor {
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 50%;
    inline-size: 0.55ch;
    block-size: 1.05em;
    margin-block-start: -0.525em;
    margin-inline-start: 0.2ch;
    background: var(--ink);
    transform: translateX(var(--command-width));
    animation: loader-travel var(--type-duration) steps(var(--command-length), end) both,
      loader-cursor 1s steps(2) infinite;
  }

  boot-loader[data-command-complete] .loader-cursor {
    animation: loader-cursor 1s steps(2) infinite;
  }

  .loader-dots {
    display: inline-block;
    min-width: 1ch;
    animation: loader-dots 1.2s steps(2, end) infinite;
  }

  .loader-overlay.is-dismissing {
    pointer-events: none;
    opacity: 0;
    transform: translateY(-0.75rem);
  }

  @keyframes loader-cursor {
    50% { opacity: 0; }
  }

  @keyframes loader-type {
    from { clip-path: inset(0 100% 0 0); }
    to { clip-path: inset(0); }
  }

  @keyframes loader-travel {
    from { transform: translateX(0); }
    to { transform: translateX(var(--command-width)); }
  }

  @keyframes loader-dots {
    50% { opacity: 0.35; }
  }

  @keyframes loader-status-in {
    to { opacity: 1; transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .loader-command-text, .loader-cursor, .loader-dots { animation: none; }
    .loader-status { animation: none; opacity: 1; transform: none; }
    .loader-overlay { transition-duration: 160ms; }
  }
</style>
