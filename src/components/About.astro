---
/**
 * About — a dry, specific bio (no tagline, no pitch) with a portrait
 * card on the right. Personality comes from specifics, not adjectives.
 * Purely static — no client JS.
 */
import Section from "./primitives/Section.astro";
import SectionLabel from "./primitives/SectionLabel.astro";
import Reveal from "./primitives/Reveal.astro";
---

<Section id="about">
  <div class="wrap">
    <Reveal>
      <SectionLabel>about</SectionLabel>
    </Reveal>

    <div class="mt-10 grid gap-12 md:grid-cols-[1.4fr_1fr] md:gap-16">
      <!-- ── bio lead ─────────────────────────────────────────── -->
      <Reveal>
        <div class="relative">
          <!-- monochrome accent bar on the left of the bio -->
          <span
            aria-hidden="true"
            class="absolute -left-4 top-1 hidden h-[calc(100%-0.5rem)] w-[2px] bg-gradient-to-b from-[var(--ink-muted)] via-[var(--ink-muted)]/40 to-transparent md:block"
          ></span>
          <p
            class="font-sans font-normal leading-[1.7] tracking-[-0.01em] text-[var(--ink)]"
            style="font-size: clamp(1.2rem, 2.2vw, 1.55rem);"
          >
              I’m a backend-focused software engineer.
              I build APIs and services primarily with C# and .NET,
              and use other languages and technologies when a project needs them.
              I’m particularly interested in system design, databases, and real-time communication.
              Outside of software development work, I enjoy working on IoT and robotics projects.

          </p>
        </div>
      </Reveal>

      <!-- ── portrait (unframed, grayscale → color on hover) ───────
           Kept smaller than the bio, but now sits directly on the page. -->
      <Reveal delay={120}>
        <figure class="group relative mx-auto w-full max-w-[11rem] sm:max-w-[13rem] md:max-w-[16rem]">
          <img
            src="/portrait-about.png"
            alt="Mohamed Islam Benyahkem at a technology event"
            loading="lazy"
            class="block h-auto w-full bw-img" />
        </figure>
      </Reveal>
    </div>
  </div>
</Section>
