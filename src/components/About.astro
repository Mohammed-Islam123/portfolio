---
/**
 * About — a dry, specific bio (no tagline, no pitch) with a portrait
 * card on the right. Personality comes from specifics, not adjectives.
 * Purely static — no client JS.
 */
import Section from "./primitives/Section.astro";
import SectionLabel from "./primitives/SectionLabel.astro";
import Reveal from "./primitives/Reveal.astro";
---

<Section id="about">
  <div class="wrap">
    <Reveal>
      <SectionLabel>about</SectionLabel>
    </Reveal>

    <div class="mt-10 grid gap-12 md:grid-cols-[1.4fr_1fr] md:gap-16">
      <!-- ── bio lead ─────────────────────────────────────────── -->
      <Reveal>
        <div class="relative">
          <!-- monochrome accent bar on the left of the bio -->
          <span
            aria-hidden="true"
            class="absolute -left-4 top-1 hidden h-[calc(100%-0.5rem)] w-[2px] bg-gradient-to-b from-[var(--ink-muted)] via-[var(--ink-muted)]/40 to-transparent md:block"
          ></span>
          <p
            class="font-sans font-normal leading-[1.7] tracking-[-0.01em] text-[var(--ink)]"
            style="font-size: clamp(1.2rem, 2.2vw, 1.55rem);"
          >
            <span class="font-normal text-[var(--ink)]">Mohamed Islam Benyahkem</span>
            — backend engineer in Algiers. I like the parts of software that
            don't get screenshots: protocols, data paths, and the bits that
            decide whether a request comes back in
            <span class="font-mono tabular-nums text-[var(--ink-muted)]">40ms</span>
            or
            <span class="font-mono tabular-nums text-[var(--ink-muted)]">400ms</span>.
          </p>
        </div>
      </Reveal>

      <!-- ── portrait (rounded, grayscale → color on hover) ────────
           Smaller across all breakpoints. Keeps the bio as the focal
           point, portrait as an accent. Placeholder portrait — swap the
           src with a real photo to replace. -->
      <Reveal delay={120}>
        <figure class="group relative mx-auto w-full max-w-[11rem] sm:max-w-[13rem] md:max-w-[16rem]">
          <div
            class="relative overflow-hidden rounded-[var(--radius-lg)] border border-[var(--line)] bg-[var(--surface)] aspect-[4/5]"
          >
            <img
              src="https://i.pravatar.cc/600?img=68"
              alt="Mohamed Islam Benyahkem — portrait placeholder"
              loading="lazy"
              class="h-full w-full object-cover bw-img" />
            <div
              aria-hidden="true"
              class="pointer-events-none absolute inset-0"
              style="background: linear-gradient(to bottom, transparent 55%, rgba(var(--scrim-color), 0.5) 100%);"
            >
            </div>
          </div>
        </figure>
      </Reveal>
    </div>
  </div>
</Section>
