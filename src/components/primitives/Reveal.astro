---
/**
 * Visible static content; the scroll observer opts offscreen elements
 * into an entrance animation after it has initialized.
 */
interface Props {
  class?: string;
  /** transition delay in ms */
  delay?: number;
}
const { class: className, delay } = Astro.props;
---

<div
  class={`reveal ${className ?? ""}`}
  style={delay ? `transition-delay: ${delay}ms;` : undefined}
>
  <slot />
</div>
