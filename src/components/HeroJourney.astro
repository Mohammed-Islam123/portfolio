---
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
import {
  heroJourneyDetails,
  heroJourneySettings,
  type HeroJourneyMedia,
} from "../config/heroJourney";

const photos = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/hero-journey/*.{jpg,jpeg,png,webp,avif}",
  { eager: true },
);
const videos = import.meta.glob<string>(
  "../assets/hero-journey/*.{mp4,webm}",
  { eager: true, query: "?url", import: "default" },
);

const filename = (path: string) => path.split("/").at(-1) ?? path;
const details = new Map(heroJourneyDetails.map((entry) => [entry.file, entry]));
const describe = (name: string) =>
  name.replace(/\.[^.]+$/, "").replace(/[-_]+/g, " ").replace(/\b\w/g, (c) => c.toUpperCase());
const imageItems = await Promise.all(
  Object.entries(photos).map(async ([path, module]): Promise<HeroJourneyMedia> => {
    const name = filename(path);
    const image = await getImage({ src: module.default, width: 640, format: "webp", quality: 78 });
    return {
      type: "image",
      source: image.src,
      description: details.get(name)?.description ?? describe(name),
      caption: details.get(name)?.caption,
      cropPosition: details.get(name)?.cropPosition,
    };
  }),
);
const videoItems: HeroJourneyMedia[] = Object.entries(videos).map(([path, source]) => {
  const name = filename(path);
  return {
    type: "video",
    source,
    description: details.get(name)?.description ?? describe(name),
    caption: details.get(name)?.caption,
    cropPosition: details.get(name)?.cropPosition,
  };
});
const media: HeroJourneyMedia[] = [...imageItems, ...videoItems];
---

{media.length > 0 && (
  <hero-journey
    class="hero-journey pointer-events-none absolute inset-0 block"
    data-media={JSON.stringify(media)}
    data-duration={heroJourneySettings.durationMs}
    data-preload-concurrency={heroJourneySettings.preloadConcurrency}
    aria-label="Project media fragments"
  ></hero-journey>
)}

<script>
  import "../scripts/hero-journey";
</script>

<style>
  .hero-journey {
    z-index: 1;
    contain: layout style;
  }

  .hero-journey :global(.journey-card) {
    --card-width: clamp(108px, 10vw, 146px);
    position: absolute;
    left: 0;
    top: 0;
    width: var(--card-width);
    aspect-ratio: 4 / 3;
    pointer-events: auto;
    opacity: 0;
    transform-origin: center;
    will-change: transform, opacity;
    isolation: isolate;
  }

  .hero-journey :global(.journey-card[data-expanded="true"]) {
    z-index: 10;
  }

  .hero-journey :global(.journey-card[data-settling="true"]) {
    transition: transform 320ms var(--ease), opacity 220ms var(--ease);
  }

  .hero-journey :global(.journey-face) {
    display: block;
    position: relative;
    width: 100%;
    height: 100%;
    padding: 0;
    overflow: hidden;
    border: 0;
    border-radius: var(--radius-sm);
    background: var(--surface-2);
    box-shadow: 0 10px 30px -14px rgb(0 0 0 / 0.55);
    cursor: zoom-in;
    text-align: left;
    transition: box-shadow 320ms var(--ease);
  }

  .hero-journey :global(.journey-card[data-expanded="true"] .journey-face) {
    background: var(--surface-3);
    box-shadow: 0 22px 55px -18px rgb(0 0 0 / 0.7);
    cursor: default;
  }

  .hero-journey :global(.journey-media) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius-sm);
    filter: blur(0.5px);
    transition: filter 320ms var(--ease);
  }

  .hero-journey :global(.journey-card[data-expanded="true"] .journey-media) {
    filter: none;
  }

  .hero-journey :global(.journey-loading) {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: var(--surface-2);
    border-radius: var(--radius-sm);
  }

  .hero-journey :global(.journey-loading::after) {
    content: "";
    width: 15px;
    height: 15px;
    border: 2px solid var(--line-strong);
    border-top-color: var(--signal);
    border-radius: 50%;
    animation: journey-spin 850ms linear infinite;
  }

  .hero-journey :global(.journey-card[data-ready="true"] .journey-loading) {
    display: none;
  }

  .hero-journey :global(.journey-caption) {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    padding: 16px 8px 7px;
    border-radius: 0 0 var(--radius-sm) var(--radius-sm);
    background: linear-gradient(transparent, rgb(0 0 0 / 0.78));
    color: white;
    font: 500 10px/1.3 var(--font-mono);
    opacity: 0;
    pointer-events: none;
    transition: opacity 220ms var(--ease);
  }

  .hero-journey :global(.journey-card[data-expanded="true"] .journey-caption) {
    opacity: 1;
  }

  .hero-journey :global(.journey-close) {
    position: absolute;
    top: -12px;
    right: -12px;
    display: none;
    width: 26px;
    height: 26px;
    place-items: center;
    border: 0;
    border-radius: 50%;
    background: var(--surface-3);
    color: var(--ink);
    font: 18px/1 var(--font-mono);
    box-shadow: 0 5px 16px rgb(0 0 0 / 0.35);
    cursor: pointer;
  }

  .hero-journey :global(.journey-card[data-pinned="true"] .journey-close) {
    display: grid;
    transform: scale(0.54);
  }

  @keyframes journey-spin { to { transform: rotate(1turn); } }

  @media (max-width: 1023px) {
    .hero-journey :global(.journey-card) { --card-width: clamp(94px, 13vw, 124px); }
  }

  @media (max-width: 639px) {
    .hero-journey :global(.journey-card) { --card-width: clamp(68px, 20vw, 84px); }
    .hero-journey :global(.journey-caption) { font-size: 8px; }
    .hero-journey :global(.journey-card[data-pinned="true"] .journey-close) { transform: scale(0.48); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-journey :global(.journey-loading::after) { animation: none; }
    .hero-journey :global(.journey-media) { filter: none; }
  }
</style>
