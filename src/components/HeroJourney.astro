---
import { localeFromPath } from "../lib/i18n";
import { useTranslations } from "../config/i18n";
import UiIcon from "./icons/UiIcon.astro";
import {
  heroJourneyDetails,
  heroJourneySettings,
  type HeroJourneyMedia,
} from "../config/heroJourney";

const describe = (name: string) =>
  name.replace(/\.[^.]+$/, "").replace(/[-_]+/g, " ").replace(/\b\w/g, (c) => c.toUpperCase());
const media: HeroJourneyMedia[] = heroJourneyDetails.map((item) => ({
  type: "image",
  source: `/Images/Hero/${item.file}`,
  thumbnail: `/Images/Hero/thumbnails/${item.file}`,
  description: item.description ?? describe(item.file),
  caption: item.caption,
  cropPosition: item.cropPosition,
}));

const locale = localeFromPath(Astro.url.pathname);
const t = useTranslations(locale);
---

{media.length > 0 && (
  <hero-journey
    class="hero-journey pointer-events-none absolute inset-0 block"
    data-media={JSON.stringify(media)}
    data-view-label={t("View")}
    data-duration={heroJourneySettings.durationMs}
    data-preload-concurrency={heroJourneySettings.preloadConcurrency}
    aria-label={t("Project media fragments")}
  >
    <dialog class="journey-viewer" aria-label={t("Expanded hero photo")} data-lenis-prevent>
      <div class="journey-viewer-panel">
        <button class="journey-viewer-close" type="button" aria-label={t("Close expanded photo")} autofocus>
          <UiIcon name="close" size={22} />
        </button>
        <figure class="journey-viewer-content"></figure>
      </div>
    </dialog>
  </hero-journey>
)}

<script>
  import "../scripts/hero-journey";
</script>

<style>
  .hero-journey {
    z-index: 20;
    contain: layout style;
  }

  .hero-journey :global(.journey-card) {
    --card-width: clamp(68px, 20vw, 84px);
    position: absolute;
    /* Path coordinates are measured from the physical viewport origin. */
    direction: ltr;
    inset-inline-start: 0;
    inset-block-start: 0;
    width: var(--card-width);
    aspect-ratio: 4 / 3;
    pointer-events: auto;
    opacity: 0;
    transform-origin: center;
    will-change: transform, opacity;
    isolation: isolate;
  }

  .hero-journey :global(.journey-card[data-expanded="true"]) {
    z-index: 10;
  }

  .hero-journey :global(.journey-card[data-viewing="true"] .journey-face) {
    opacity: 0;
  }

  .hero-journey :global(.journey-card[data-settling="true"]) {
    transition: transform 320ms var(--ease), opacity 220ms var(--ease);
  }

  .hero-journey :global(.journey-face) {
    display: block;
    position: relative;
    width: 100%;
    height: 100%;
    padding: 0;
    overflow: hidden;
    border: 0;
    border-radius: var(--radius-sm);
    background: var(--surface-2);
    box-shadow: 0 10px 30px -14px rgb(0 0 0 / 0.55);
    cursor: zoom-in;
    text-align: start;
    transition: box-shadow 320ms var(--ease);
  }

  .hero-journey :global(.journey-card[data-expanded="true"] .journey-face) {
    background: var(--surface-3);
    box-shadow: 0 22px 55px -18px rgb(0 0 0 / 0.7);
    cursor: default;
  }

  .hero-journey :global(.journey-media) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius-sm);
  }

  .hero-journey :global(.journey-loading) {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: var(--surface-2);
    border-radius: var(--radius-sm);
  }

  .hero-journey :global(.journey-loading::after) {
    content: "";
    width: 15px;
    height: 15px;
    border: 2px solid var(--line-strong);
    border-top-color: var(--signal);
    border-radius: 50%;
    animation: journey-spin 850ms linear infinite;
  }

  .hero-journey :global(.journey-card[data-ready="true"] .journey-loading) {
    display: none;
  }

  .journey-viewer {
    position: fixed;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    max-inline-size: none;
    max-block-size: none;
    margin: 0;
    padding: 0;
    overflow: hidden;
    contain: layout;
    border: 0;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--ink);
    pointer-events: auto;
  }

  .journey-viewer::backdrop {
    background: rgba(var(--scrim-color), 0.85);
    backdrop-filter: blur(5px);
  }

  :global(html) {
    scrollbar-gutter: stable;
  }

  :global(html:has(.journey-viewer[open])) {
    overflow: hidden;
  }

  .journey-viewer-panel {
    position: absolute;
    inset-inline: 0;
    inset-block-start: 50%;
    inline-size: min(calc(100vw - 2rem), 80rem, calc((100svh - 8rem) * var(--viewer-ratio)));
    aspect-ratio: var(--viewer-ratio);
    margin-inline: auto;
    transform: translateY(-50%);
  }

  .journey-viewer-content {
    position: absolute;
    inset: 0;
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius-sm);
  }

  .journey-viewer :global(.journey-viewer-media) {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: contain;
    border-radius: var(--radius-sm);
  }

  .journey-viewer :global(.journey-viewer-caption) {
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    padding-block: 2.5rem 0.875rem;
    padding-inline: 1rem;
    background: linear-gradient(to top, rgb(0 0 0 / 0.95), rgb(0 0 0 / 0.8) 55%, transparent);
    color: white;
    font: 400 0.875rem/1.5 var(--font-sans);
    text-align: center;
    overflow-wrap: anywhere;
  }

  .journey-viewer-close {
    position: absolute;
    z-index: 1;
    inset-block-start: -48px;
    inset-inline-end: 0.5rem;
    display: grid;
    inline-size: 44px;
    block-size: 44px;
    place-items: center;
    border: 0;
    border-radius: 50%;
    background: var(--surface-3);
    color: var(--ink);
    cursor: pointer;
  }

  @keyframes journey-spin { to { transform: rotate(1turn); } }

  @media (min-width: 640px) {
    .hero-journey :global(.journey-card) { --card-width: clamp(94px, 13vw, 124px); }
  }

  @media (min-width: 1024px) {
    .hero-journey :global(.journey-card) { --card-width: clamp(108px, 10vw, 146px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-journey :global(.journey-loading::after) { animation: none; }
    .hero-journey :global(.journey-card),
    .hero-journey :global(.journey-face) { transition: none; }
  }
</style>
