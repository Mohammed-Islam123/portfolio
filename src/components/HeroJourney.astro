---
import { localeFromPath } from "../lib/i18n";
import { useTranslations } from "../config/i18n";
import UiIcon from "./icons/UiIcon.astro";
import {
  heroJourneyDetails,
  heroJourneySettings,
  type HeroJourneyMedia,
} from "../config/heroJourney";

const describe = (name: string) =>
  name.replace(/\.[^.]+$/, "").replace(/[-_]+/g, " ").replace(/\b\w/g, (c) => c.toUpperCase());
const media: HeroJourneyMedia[] = heroJourneyDetails.map((item) => ({
  type: "image",
  source: `/Images/Hero/${item.file}`,
  description: item.description ?? describe(item.file),
  caption: item.caption,
  cropPosition: item.cropPosition,
}));

const locale = localeFromPath(Astro.url.pathname);
const t = useTranslations(locale);
---

{media.length > 0 && (
  <hero-journey
    class="hero-journey pointer-events-none absolute inset-0 block"
    data-media={JSON.stringify(media)}
    data-view-label={t("View")}
    data-duration={heroJourneySettings.durationMs}
    data-preload-concurrency={heroJourneySettings.preloadConcurrency}
    aria-label={t("Project media fragments")}
  >
    <dialog class="journey-viewer" aria-label={t("Expanded hero photo")} data-lenis-prevent>
      <button class="journey-viewer-close" type="button" aria-label={t("Close expanded photo")} autofocus>
        <UiIcon name="close" size={22} />
      </button>
      <div class="journey-viewer-content"></div>
    </dialog>
  </hero-journey>
)}

<script>
  import "../scripts/hero-journey";
</script>

<style>
  .hero-journey {
    z-index: 20;
    contain: layout style;
  }

  .hero-journey :global(.journey-card) {
    --card-width: clamp(108px, 10vw, 146px);
    position: absolute;
    left: 0;
    top: 0;
    width: var(--card-width);
    aspect-ratio: 4 / 3;
    pointer-events: auto;
    opacity: 0;
    transform-origin: center;
    will-change: transform, opacity;
    isolation: isolate;
  }

  .hero-journey :global(.journey-card[data-expanded="true"]) {
    z-index: 10;
  }

  .hero-journey :global(.journey-card[data-viewing="true"] .journey-face) {
    opacity: 0;
  }

  .hero-journey :global(.journey-card[data-settling="true"]) {
    transition: transform 320ms var(--ease), opacity 220ms var(--ease);
  }

  .hero-journey :global(.journey-face) {
    display: block;
    position: relative;
    width: 100%;
    height: 100%;
    padding: 0;
    overflow: hidden;
    border: 0;
    border-radius: var(--radius-sm);
    background: var(--surface-2);
    box-shadow: 0 10px 30px -14px rgb(0 0 0 / 0.55);
    cursor: zoom-in;
    text-align: left;
    transition: box-shadow 320ms var(--ease);
  }

  .hero-journey :global(.journey-card[data-expanded="true"] .journey-face) {
    background: var(--surface-3);
    box-shadow: 0 22px 55px -18px rgb(0 0 0 / 0.7);
    cursor: default;
  }

  .hero-journey :global(.journey-media) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius-sm);
    filter: blur(0.5px);
    transition: filter 320ms var(--ease);
  }

  .hero-journey :global(.journey-card[data-expanded="true"] .journey-media) {
    filter: none;
  }

  .hero-journey :global(.journey-loading) {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: var(--surface-2);
    border-radius: var(--radius-sm);
  }

  .hero-journey :global(.journey-loading::after) {
    content: "";
    width: 15px;
    height: 15px;
    border: 2px solid var(--line-strong);
    border-top-color: var(--signal);
    border-radius: 50%;
    animation: journey-spin 850ms linear infinite;
  }

  .hero-journey :global(.journey-card[data-ready="true"] .journey-loading) {
    display: none;
  }

  .hero-journey :global(.journey-caption) {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    padding: 16px 8px 7px;
    border-radius: 0 0 var(--radius-sm) var(--radius-sm);
    background: linear-gradient(transparent, rgb(0 0 0 / 0.78));
    color: white;
    font: 500 10px/1.3 var(--font-mono);
    opacity: 0;
    pointer-events: none;
    transition: opacity 220ms var(--ease);
  }

  .hero-journey :global(.journey-card[data-expanded="true"] .journey-caption) {
    opacity: 1;
  }

  .journey-viewer {
    width: min(94vw, 80rem, calc((100svh - 6rem) * var(--viewer-ratio)));
    height: auto;
    aspect-ratio: var(--viewer-ratio);
    max-width: none;
    max-height: none;
    margin: auto;
    padding: 0;
    overflow: visible;
    border: 0;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--ink);
    pointer-events: auto;
  }

  .journey-viewer::backdrop {
    background: rgba(var(--scrim-color), 0.85);
    backdrop-filter: blur(5px);
  }

  :global(html:has(.journey-viewer[open])) {
    overflow: hidden;
  }

  .journey-viewer-content {
    width: 100%;
    height: 100%;
  }

  .journey-viewer :global(.journey-viewer-media) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius-sm);
  }

  .journey-viewer-close {
    position: absolute;
    top: -44px;
    right: 0.5rem;
    display: grid;
    width: 40px;
    height: 40px;
    place-items: center;
    border: 0;
    border-radius: 50%;
    background: var(--surface-3);
    color: var(--ink);
    cursor: pointer;
  }

  @keyframes journey-spin { to { transform: rotate(1turn); } }

  @media (max-width: 1023px) {
    .hero-journey :global(.journey-card) { --card-width: clamp(94px, 13vw, 124px); }
  }

  @media (max-width: 639px) {
    .hero-journey :global(.journey-card) { --card-width: clamp(68px, 20vw, 84px); }
    .hero-journey :global(.journey-caption) { font-size: 8px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-journey :global(.journey-loading::after) { animation: none; }
    .hero-journey :global(.journey-media) { filter: none; }
  }
</style>
