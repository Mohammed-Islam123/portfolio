---
/**
 * Landing — single-page portfolio.
 * Order: Hero → About → Projects → Toolkit → Values → Contact.
 *
 * The <Loader /> mounts on top (z-[100], fixed) — a terminal-style
 * loading overlay that types `~/mohamed-islam $ whoami` while the
 * page's assets load. Once typing and window.load (or the 5s safety
 * timeout) finish, it dispatches `loader:dismiss` so the hero
 * fades in and the name scrambles into place. Transparent overlay —
 * the hero's <DotField /> is visible behind it.
 *
 * The root wrapper uses min-h-screen + flex-col so the footer sticks
 * to the bottom on short content and pushes down naturally on long.
 */
import Layout from "../layouts/Layout.astro";
import NavBar from "../components/NavBar.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Projects from "../components/Projects.astro";
import Toolkit from "../components/Toolkit.astro";
// import Values from "../components/Values.astro";
import Contact from "../components/Contact.astro";
import { siteConfig } from "../config/site";
import { localeFromPath, localizedPath } from "../lib/i18n";
import { useTranslations } from "../config/i18n";

const locale = localeFromPath(Astro.url.pathname);
const t = useTranslations(locale);
const url = new URL(localizedPath(locale), Astro.site);
const profile = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "@id": `${url.href}#profile`,
  url: url.href,
  inLanguage: locale,
  mainEntity: {
    "@type": "Person",
    "@id": new URL("/#person", Astro.site).href,
    name: siteConfig.fullName,
    url: new URL("/", Astro.site).href,
    jobTitle: t(siteConfig.role),
    image: new URL("/portrait-about.webp", Astro.site).href,
    sameAs: siteConfig.socialProfiles.filter(({ icon }) => icon === "github" || icon === "linkedin").map(({ href }) => href),
  },
};

---

<Layout>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(profile).replace(/</g, "\\u003c")} />
  <div class="relative flex min-h-[100svh] flex-col">
    <NavBar />
    <main class="flex-1">
      <Hero />
      <About />
      <Projects />
      <Toolkit />
      {/* Values section hidden for now */}
    </main>
    <Contact />
  </div>
</Layout>
