---

import Layout from "../layouts/Layout.astro";
import NavBar from "../components/NavBar.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Projects from "../components/Projects.astro";
import Toolkit from "../components/Toolkit.astro";
import ArticleTools from "../components/ArticleTools.astro";

import Contact from "../components/Contact.astro";
import { siteConfig } from "../config/site";
import { localeFromPath, localizedPath } from "../lib/i18n";
import { useTranslations } from "../config/i18n";

const locale = localeFromPath(Astro.url.pathname);
const t = useTranslations(locale);
const url = new URL(localizedPath(locale), Astro.site);
const profile = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "@id": `${url.href}#profile`,
  url: url.href,
  inLanguage: locale,
  mainEntity: {
    "@type": "Person",
    "@id": new URL("/#person", Astro.site).href,
    name: siteConfig.fullName,
    url: new URL("/", Astro.site).href,
    jobTitle: t(siteConfig.role),
    image: new URL("/portrait-about.webp", Astro.site).href,
    sameAs: siteConfig.socialProfiles.filter(({ icon }) => icon === "github" || icon === "linkedin").map(({ href }) => href),
  },
};

---

<Layout>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(profile).replace(/</g, "\\u003c")} />
  <div class="relative flex min-h-[100svh] flex-col">
    <NavBar />
    <main class="flex-1">
      <Hero />
      <About />
      <Projects />
      <Toolkit />

    </main>
    <Contact />
  </div>
  <ArticleTools />
</Layout>
