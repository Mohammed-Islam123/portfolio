---
/**
 * Landing — single-page portfolio.
 * Order: Hero → About → Projects → Toolkit → Values → Contact.
 *
 * The <Loader /> mounts on top (z-[100], fixed) — a terminal-style
 * loading overlay that types `~/mohamed-islam $ whoami` while the
 * page's assets load. When ready (window.load OR 2.2s floor OR 5s
 * timeout), it lifts off and dispatches `loader:dismiss` so the hero
 * fades in and the name scrambles into place. Transparent overlay —
 * the hero's <DotField /> is visible behind it.
 *
 * The root wrapper uses min-h-screen + flex-col so the footer sticks
 * to the bottom on short content and pushes down naturally on long.
 */
import Layout from "../layouts/Layout.astro";
import NavBar from "../components/NavBar.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Projects from "../components/Projects.astro";
import Toolkit from "../components/Toolkit.astro";
import Values from "../components/Values.astro";
import Contact from "../components/Contact.astro";
---

<Layout>
  <div class="relative flex min-h-[100svh] flex-col">
    <NavBar />
    <main class="flex-1">
      <Hero />
      <About />
      <Projects />
      <Toolkit />
      <Values />
    </main>
    <Contact />
  </div>
</Layout>
