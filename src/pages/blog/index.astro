---
import Layout from "../../layouts/Layout.astro";
import BlogBar from "../../components/BlogBar.astro";
import BlogCard from "../../components/BlogCard.astro";
import Reveal from "../../components/primitives/Reveal.astro";
import { getPosts } from "../../lib/blog";

const posts = await getPosts();
---

<Layout
  title="Blog · Mohamed Islam"
  description="Backend notes — protocols, data paths, and the habits that keep systems honest."
>
  <BlogBar />
  <main class="blog-index">
    <div class="wrap blog-index__inner">
      <Reveal delay={70}><h1 class="blog-index__title">Notes from the wire.</h1></Reveal>
      <Reveal delay={120}>
        <p class="blog-index__intro">Longer-form notes on backend work — the decisions, failures, and small habits that keep systems honest.</p>
      </Reveal>
      <Reveal delay={160}>
        <p class="blog-index__links">
          {posts.length} {posts.length === 1 ? "post" : "posts"}
          <span aria-hidden="true">·</span>
          <a href="/blog/tags/">browse tags</a>
          <span aria-hidden="true">·</span>
          <a href="/rss.xml">RSS</a>
        </p>
      </Reveal>

      <div class="blog-index__list">
        {posts.length > 0 ? posts.map((post, index) => (
          <Reveal delay={Math.min(220 + index * 60, 480)}><BlogCard {post} {index} /></Reveal>
        )) : <p class="blog-index__empty">Posts will appear here soon.</p>}
      </div>
    </div>
  </main>
</Layout>

<style>
  .blog-index { min-height: 100svh; padding: calc(var(--nav-h) + 3rem) 0 4rem; }
  .blog-index__inner { max-width: 72rem; }
  .blog-index__title { max-width: 55rem; margin: 0.75rem 0 0; font-family: var(--font-display); font-size: clamp(2.75rem, 8vw, 6rem); font-weight: 650; letter-spacing: -0.055em; line-height: 0.98; color: var(--ink); overflow-wrap: anywhere; }
  .blog-index__intro { max-width: 42rem; margin: 1.25rem 0 0; color: var(--ink-muted); font-size: clamp(1rem, 1.8vw, 1.15rem); }
  .blog-index__links { display: flex; flex-wrap: wrap; gap: 0.45rem; margin: 1rem 0 0; font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.05em; color: var(--ink-dim); }
  .blog-index__links a { color: var(--ink-muted); text-decoration: none; }
  .blog-index__links a:hover { color: var(--ink); text-decoration: underline; text-underline-offset: 0.2em; }
  .blog-index__list { margin-top: 3rem; }
  .blog-index__empty { color: var(--ink-dim); }
</style>
