---
import { localeFromPath, localizedPath, locales, type Locale } from "../lib/i18n";
import { useTranslations } from "../config/i18n";
import { portfolioCopy } from "../config/portfolio";
import { siteConfig } from "../config/site";
import { ClientRouter } from "astro:transitions";
import Loader from "../components/Loader.astro";
import RouteLoader from "../components/RouteLoader.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  canonicalPath?: string;
  availableLocales?: Locale[];
  description?: string;
  noindex?: boolean;
  loading?: {
    mode: "home" | "article" | "generic";
    slug?: string;
  } | false;
}

const locale = localeFromPath(Astro.url.pathname);
const t = useTranslations(locale);
const {
  canonicalPath = Astro.url.pathname,
  availableLocales = [...locales],
  title = `Mohamed Islam — ${t("Backend Engineer")}`,
  description = t(portfolioCopy.description),
  noindex = false,
  loading = localizedPath("en", Astro.url.pathname) === "/" ? { mode: "home" } : false,
} = Astro.props;

const canonical = new URL(canonicalPath, Astro.site);
const ogImage = new URL("/portrait-about.webp", Astro.site);
---

<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta
      name="keywords"
      content="backend engineer, system design, distributed systems, C#, .NET, Astro, portfolio"
    />
    <meta name="author" content={siteConfig.fullName} />
    <link rel="canonical" href={canonical} />
    {!noindex && availableLocales.map((lang) => <link rel="alternate" hreflang={lang} href={new URL(localizedPath(lang, canonicalPath), Astro.site)} />)}
    <meta property="og:locale" content={locale === "fr" ? "fr_FR" : "en_GB"} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Mohamed Islam — blog"
      href={new URL(localizedPath(locale, "/rss.xml"), Astro.site)}
    />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="300" />
    <meta property="og:image:height" content="300" />
    <meta property="og:image:alt" content={siteConfig.fullName} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={siteConfig.fullName} />

    <ClientRouter />

    <!-- no-FOUC theme script: set the html class from localStorage /
         prefers-color-scheme BEFORE first paint so the correct palette
         renders immediately (no white flash on dark load, no dark flash
         on light load). Re-applied after every ClientRouter swap so a
         stale class never leaks between pages. -->
    <script is:inline>
      (function () {
        function applyTheme() {
          try {
            var t = localStorage.getItem("theme");
            if (!t) {
              t = window.matchMedia("(prefers-color-scheme: light)").matches
                ? "light"
                : "dark";
            }
            var root = document.documentElement;
            root.classList.remove("dark", "light");
            root.classList.add(t);
          } catch (e) {
            document.documentElement.classList.add("dark");
          }
        }
        document.addEventListener("astro:after-swap", applyTheme);
        applyTheme();
      })();
    </script>
  </head>
  <body class="antialiased">
    {loading && <Loader mode={loading.mode} slug={loading.slug} />}
    <RouteLoader />
    <div data-page-transition-root>
      <slot />
    </div>
    <script>
      import "../scripts/smooth-scroll";
      import "../scripts/custom-cursor";
      import "../scripts/reveal";
      import "../scripts/sound-init";
      import "../scripts/route-transition";
    </script>
  </body>
</html>
